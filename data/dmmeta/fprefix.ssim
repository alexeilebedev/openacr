dmmeta.fprefix  fprefix:bh.Bheap  require:Y  dflt:Y  comment:"Binary heap"
dmmeta.fprefix  fprefix:c.Delptr  require:N  dflt:N  comment:"Owned pointer; c_ allowed but Delptr fields may use any name"
dmmeta.fprefix  fprefix:c.Ptr  require:N  dflt:N  comment:"Pointer; c_ allowed but Ptr fields may use any name"
dmmeta.fprefix  fprefix:c.Ptrary  require:Y  dflt:Y  comment:"Pointer array"
dmmeta.fprefix  fprefix:cd.Llist  require:Y  dflt:Y  comment:"Circular doubly linked list"
dmmeta.fprefix  fprefix:cdl.Llist  require:Y  dflt:Y  comment:"Circular doubly linked LIFO list"
dmmeta.fprefix  fprefix:cnt.Count  require:Y  dflt:Y  comment:"Count of items"
dmmeta.fprefix  fprefix:cs.Llist  require:Y  dflt:Y  comment:"Circular singly linked list"
dmmeta.fprefix  fprefix:csl.Llist  require:Y  dflt:Y  comment:"Circular singly linked LIFO list"
dmmeta.fprefix  fprefix:ind.Blkhash  require:Y  dflt:N  comment:"Block hash index for keys with a dense component"
dmmeta.fprefix  fprefix:ind.Thash  require:Y  dflt:Y  comment:"Hash table (index)"
dmmeta.fprefix  fprefix:p.Ptr  require:N  dflt:N  comment:"Pointer; p_ allowed but Ptr fields may use any name"
dmmeta.fprefix  fprefix:p.Upptr  require:Y  dflt:Y  comment:"Up-pointer: equivalent of Pkey reference for in-memory model"
dmmeta.fprefix  fprefix:tr.Atree  require:Y  dflt:Y  comment:"AVL tree"
dmmeta.fprefix  fprefix:zd.Llist  require:Y  dflt:Y  comment:"Zero-terminated doubly linked list"
dmmeta.fprefix  fprefix:zdl.Llist  require:Y  dflt:Y  comment:"Zero-terminated doubly linked LIFO list"
dmmeta.fprefix  fprefix:zs.Llist  require:Y  dflt:Y  comment:"Zero-terminated singly linked list"
dmmeta.fprefix  fprefix:zs.ZSListMT  require:Y  dflt:N  comment:"Zero-terminated singly linked list with atomic head (multithreaded)"
dmmeta.fprefix  fprefix:zsl.Llist  require:Y  dflt:Y  comment:"Zero-terminated singly linked LIFO list"
