amcdb.regxrule  regxrule:acr/  out:""  comment:"Any other character passes through, so ( ) [ ] | stay operators"
amcdb.regxrule  regxrule:acr/$  out:"\\$"  comment:"Means itself"
amcdb.regxrule  regxrule:acr/%  out:.*  comment:"Any run of characters"
amcdb.regxrule  regxrule:acr/*  out:"\\*"  comment:"Means itself"
amcdb.regxrule  regxrule:acr/+  out:"\\+"  comment:"Means itself"
amcdb.regxrule  regxrule:acr/.  out:"\\."  comment:"Means itself"
amcdb.regxrule  regxrule:"acr/?"  out:"\\?"  comment:"Means itself"
amcdb.regxrule  regxrule:"acr/\\"  out:"\\"  comment:"Any other escaped character stays escaped"
amcdb.regxrule  regxrule:"acr/\\%"  out:%  comment:"A literal percent sign"
amcdb.regxrule  regxrule:acr/^  out:"\\^"  comment:"Means itself"
amcdb.regxrule  regxrule:default/  out:""  comment:"Every character passes through"
amcdb.regxrule  regxrule:shell/  out:""  comment:"Any other character passes through"
amcdb.regxrule  regxrule:shell/$  out:"\\$"  comment:"Means itself"
amcdb.regxrule  regxrule:"shell/("  out:"\\("  comment:"Means itself"
amcdb.regxrule  regxrule:"shell/)"  out:"\\)"  comment:"Means itself"
amcdb.regxrule  regxrule:shell/*  out:.*  comment:"Any run of characters"
amcdb.regxrule  regxrule:shell/.  out:"\\."  comment:"Means itself"
amcdb.regxrule  regxrule:"shell/?"  out:".?"  comment:"At most one character"
amcdb.regxrule  regxrule:"shell/["  out:"\\["  comment:"Means itself"
amcdb.regxrule  regxrule:"shell/\\"  out:"\\\\"  comment:"Means itself"
amcdb.regxrule  regxrule:"shell/]"  out:"\\]"  comment:"Means itself"
amcdb.regxrule  regxrule:shell/^  out:"\\^"  comment:"Means itself"
amcdb.regxrule  regxrule:sql/  out:""  comment:"Any other character passes through, so ( ) [ ] | stay operators"
amcdb.regxrule  regxrule:sql/$  out:"\\$"  comment:"Means itself"
amcdb.regxrule  regxrule:sql/%  out:.*  comment:"Any run of characters"
amcdb.regxrule  regxrule:sql/*  out:"\\*"  comment:"Means itself"
amcdb.regxrule  regxrule:sql/+  out:"\\+"  comment:"Means itself"
amcdb.regxrule  regxrule:sql/.  out:"\\."  comment:"Means itself"
amcdb.regxrule  regxrule:"sql/?"  out:"\\?"  comment:"Means itself"
amcdb.regxrule  regxrule:"sql/\\"  out:"\\"  comment:"Any other escaped character stays escaped"
amcdb.regxrule  regxrule:"sql/\\%"  out:%  comment:"A literal percent sign"
amcdb.regxrule  regxrule:"sql/\\_"  out:_  comment:"A literal underscore"
amcdb.regxrule  regxrule:sql/^  out:"\\^"  comment:"Means itself"
amcdb.regxrule  regxrule:sql/_  out:.  comment:"Any one character"
