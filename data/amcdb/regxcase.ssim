amcdb.regxcase  regxcase:acr_alt  regxstyle:acr  pattern:"ns:(amc|acr)"  subject:ns:acr  full:Y  match:Y  comment:"Alternatives in acr"
amcdb.regxcase  regxcase:acr_underscore  regxstyle:acr  pattern:a_b  subject:a_b  full:Y  match:Y  comment:"_ means itself in acr"
amcdb.regxcase  regxcase:acr_underscore_x  regxstyle:acr  pattern:a_b  subject:axb  full:Y  match:N  comment:"_ means itself in acr"
amcdb.regxcase  regxcase:dflt_alt_emptygroup  regxstyle:default  pattern:"(|a)b"  subject:b  full:Y  match:Y  comment:"An empty alternative inside a group"
amcdb.regxcase  regxcase:dflt_anchor_quant  regxstyle:default  pattern:^*a  subject:*a  full:Y  match:Y  comment:"An anchor takes no quantifier"
amcdb.regxcase  regxcase:dflt_class_dash  regxstyle:default  pattern:"[a-]"  subject:-  full:Y  match:Y  comment:"A - at the end of a class is literal"
amcdb.regxcase  regxcase:dflt_class_esc  regxstyle:default  pattern:"[\\]a]"  subject:"]"  full:Y  match:Y  comment:"An escaped ] is a member of the class"
amcdb.regxcase  regxcase:dflt_class_macro  regxstyle:default  pattern:"[\\d.]+"  subject:1.2  full:Y  match:Y  comment:"An escape class inside a class"
amcdb.regxcase  regxcase:dflt_class_neg  regxstyle:default  pattern:"[^a-c]"  subject:d  full:Y  match:Y  comment:"A negated class"
amcdb.regxcase  regxcase:dflt_class_reversed  regxstyle:default  pattern:"[c-a]"  subject:c  full:Y  match:Y  comment:"A reversed range keeps its start"
amcdb.regxcase  regxcase:dflt_dot_newline  regxstyle:default  pattern:a.b  subject:"a\nb"  full:Y  match:Y  comment:"A dot matches a newline"
amcdb.regxcase  regxcase:dflt_empty_group  regxstyle:default  pattern:"a()b"  subject:ab  full:Y  match:Y  comment:"An empty group"
amcdb.regxcase  regxcase:dflt_negclass_member  regxstyle:default  pattern:"[^ab]"  subject:b  full:Y  match:N  comment:"A negated class excludes each of its members"
amcdb.regxcase  regxcase:dflt_negclass_order  regxstyle:default  pattern:"[^ba]"  subject:a  full:Y  match:N  comment:"Members in any order"
amcdb.regxcase  regxcase:dflt_negclass_other  regxstyle:default  pattern:"[^ab]"  subject:c  full:Y  match:Y  comment:"A negated class takes any other character"
amcdb.regxcase  regxcase:dflt_nonspace  regxstyle:default  pattern:"\\S+"  subject:ab  full:Y  match:Y  comment:"A backslash and S is anything but whitespace"
amcdb.regxcase  regxcase:dflt_quant_mix  regxstyle:default  pattern:"a+?"  subject:""  full:Y  match:Y  comment:"+ then ? is *"
amcdb.regxcase  regxcase:dflt_quant_noatom  regxstyle:default  pattern:*a  subject:*a  full:Y  match:Y  comment:"A quantifier with nothing to repeat is literal"
amcdb.regxcase  regxcase:dflt_quant_quant  regxstyle:default  pattern:a**  subject:aaa  full:Y  match:Y  comment:"A quantifier after a quantifier"
amcdb.regxcase  regxcase:dflt_word  regxstyle:default  pattern:"\\w+"  subject:ab_9  full:Y  match:Y  comment:"A backslash and w is a word character"
amcdb.regxcase  regxcase:shell_dot  regxstyle:shell  pattern:*.cpp  subject:xcpp  full:Y  match:N  comment:"A dot means itself"
amcdb.regxcase  regxcase:shell_paren  regxstyle:shell  pattern:"(a)"  subject:"(a)"  full:Y  match:Y  comment:"Shell reads ( and ) as themselves"
amcdb.regxcase  regxcase:shell_star  regxstyle:shell  pattern:*.cpp  subject:x.cpp  full:Y  match:Y  comment:"* is any run of characters"
amcdb.regxcase  regxcase:sql_alt_emptyleft  regxstyle:sql  pattern:"|a"  subject:""  full:Y  match:Y  comment:"An empty alternative matches the empty string"
amcdb.regxcase  regxcase:sql_alt_emptyleft_a  regxstyle:sql  pattern:"|a"  subject:a  full:Y  match:Y  comment:"Beside an empty alternative, the other one still matches"
amcdb.regxcase  regxcase:sql_alt_emptyleft_lit  regxstyle:sql  pattern:"|a"  subject:"|a"  full:Y  match:N  comment:"The | is an operator"
amcdb.regxcase  regxcase:sql_alt_emptymid  regxstyle:sql  pattern:"a||b"  subject:""  full:Y  match:Y  comment:"An empty alternative between two others"
amcdb.regxcase  regxcase:sql_alt_emptymid_b  regxstyle:sql  pattern:"a||b"  subject:b  full:Y  match:Y  comment:"An empty alternative between two others"
amcdb.regxcase  regxcase:sql_alt_emptyright  regxstyle:sql  pattern:"a|"  subject:""  full:Y  match:Y  comment:"An empty alternative matches the empty string"
amcdb.regxcase  regxcase:sql_alt_rx  regxstyle:sql  pattern:"%.(tx|rx)_bytes"  subject:gw-0-0.rx_bytes  full:Y  match:Y  comment:"The other alternative"
amcdb.regxcase  regxcase:sql_alt_tx  regxstyle:sql  pattern:"%.(tx|rx)_bytes"  subject:gw-0-0.tx_bytes  full:Y  match:Y  comment:"A group of alternatives"
amcdb.regxcase  regxcase:sql_brace  regxstyle:sql  pattern:"a{2}"  subject:aa  full:Y  match:N  comment:"Braces mean themselves"
amcdb.regxcase  regxcase:sql_brace_lit  regxstyle:sql  pattern:"a{2}"  subject:"a{2}"  full:Y  match:Y  comment:"Braces mean themselves"
amcdb.regxcase  regxcase:sql_case  regxstyle:sql  pattern:%.tx_bytes  subject:GW-0-0.TX_BYTES  full:Y  match:N  comment:"Case counts"
amcdb.regxcase  regxcase:sql_class  regxstyle:sql  pattern:"[a-c]%"  subject:bz  full:Y  match:Y  comment:"A class with a range"
amcdb.regxcase  regxcase:sql_class_noclose  regxstyle:sql  pattern:"[ab"  subject:"[ab"  full:Y  match:Y  comment:"A [ with no ] after it is literal"
amcdb.regxcase  regxcase:sql_close_noopen  regxstyle:sql  pattern:"ab)"  subject:ab  full:Y  match:N  comment:""
amcdb.regxcase  regxcase:sql_dot  regxstyle:sql  pattern:a.c  subject:abc  full:Y  match:N  comment:"A dot means itself"
amcdb.regxcase  regxcase:sql_esc_b  regxstyle:sql  pattern:"\\b"  subject:b  full:Y  match:Y  comment:"An escape that names no class is the letter"
amcdb.regxcase  regxcase:sql_esc_d  regxstyle:sql  pattern:"\\d%"  subject:5x  full:Y  match:Y  comment:"A backslash and d is a digit"
amcdb.regxcase  regxcase:sql_esc_percent  regxstyle:sql  pattern:"a\\%"  subject:a%  full:Y  match:Y  comment:"An escaped % is literal"
amcdb.regxcase  regxcase:sql_esc_underscore  regxstyle:sql  pattern:"a\\_b"  subject:axb  full:Y  match:N  comment:"An escaped _ is literal"
amcdb.regxcase  regxcase:sql_open_noclose  regxstyle:sql  pattern:"(ab"  subject:"(ab"  full:Y  match:N  comment:"An unclosed ( makes the pattern invalid, so even its own text fails"
amcdb.regxcase  regxcase:sql_open_noclose_ab  regxstyle:sql  pattern:"(ab"  subject:ab  full:Y  match:N  comment:"An unclosed ( makes the pattern invalid"
amcdb.regxcase  regxcase:sql_open_noclose_part  regxstyle:sql  pattern:"%(cmt|"  subject:x  full:Y  match:N  comment:""
amcdb.regxcase  regxcase:sql_part  regxstyle:sql  pattern:tx_bytes  subject:gw-0-0.tx_bytes  full:N  match:Y  comment:"A partial pattern matches any part"
amcdb.regxcase  regxcase:sql_trailing_esc  regxstyle:sql  pattern:"a\\"  subject:a  full:Y  match:Y  comment:"A trailing backslash is dropped"
amcdb.regxcase  regxcase:sql_underscore_any  regxstyle:sql  pattern:%.tx_bytes  subject:gw-0-0.txXbytes  full:Y  match:Y  comment:"_ is any one character"
amcdb.regxcase  regxcase:sql_whole  regxstyle:sql  pattern:tx_bytes  subject:gw-0-0.tx_bytes  full:Y  match:N  comment:"A full pattern covers the whole subject"
amcdb.regxcase  regxcase:utf8_alt  regxstyle:sql  pattern:"%.(café|tea)"  subject:"x.café"  full:Y  match:Y  comment:"A non-ASCII literal in an alternative"
amcdb.regxcase  regxcase:utf8_any_one  regxstyle:sql  pattern:_  subject:"é"  full:Y  match:N  comment:"_ is one byte, and é is two"
amcdb.regxcase  regxcase:utf8_any_two  regxstyle:sql  pattern:__  subject:"é"  full:Y  match:Y  comment:"_ is one byte, and é is two"
amcdb.regxcase  regxcase:utf8_class  regxstyle:default  pattern:"[é]"  subject:"é"  full:Y  match:N  comment:"A class holds the bytes of é, and matches one of them"
amcdb.regxcase  regxcase:utf8_group  regxstyle:default  pattern:"caf(é)"  subject:"café"  full:Y  match:Y  comment:"A non-ASCII literal in a group"
amcdb.regxcase  regxcase:utf8_lit  regxstyle:sql  pattern:caf%  subject:"café"  full:Y  match:Y  comment:"A non-ASCII subject under a run"
amcdb.regxcase  regxcase:utf8_nfa_lit  regxstyle:sql  pattern:"%é_"  subject:"xéz"  full:Y  match:Y  comment:"A non-ASCII literal on the NFA path"
amcdb.regxcase  regxcase:utf8_notword  regxstyle:default  pattern:"\\W\\W"  subject:"é"  full:Y  match:Y  comment:"\\W matches each byte of é"
amcdb.regxcase  regxcase:utf8_pattern  regxstyle:sql  pattern:"%é"  subject:"café"  full:Y  match:Y  comment:"A non-ASCII literal in a pattern"
amcdb.regxcase  regxcase:utf8_range  regxstyle:default  pattern:"[a-é]+"  subject:"bé"  full:Y  match:Y  comment:"A range runs over bytes, so it covers both bytes of é"
