dev.gitpath  gitpath:.claude/%  comment:"Claude Code settings; skills links to .agents/skills"
dev.gitpath  gitpath:.envrc  comment:"direnv environment"
dev.gitpath  gitpath:.ffroot  comment:"Marks the root of the tree for ff"
dev.gitpath  gitpath:.gitattributes  comment:""
dev.gitpath  gitpath:.github/%.yml  comment:"GitHub Actions workflows"
dev.gitpath  gitpath:.gitignore  comment:""
dev.gitpath  gitpath:LICENSE  comment:""
dev.gitpath  gitpath:Makefile  comment:"Bootstrap build entry point"
dev.gitpath  gitpath:README.md  comment:""
dev.gitpath  gitpath:bin/%  comment:"Scripts, and links to the built executables"
dev.gitpath  gitpath:build/.ffskip  comment:"Keeps ff out of the build directory"
dev.gitpath  gitpath:conf/%  comment:"Configuration for tools the tree uses"
dev.gitpath  gitpath:cpp/%.cpp  comment:"C++ source"
dev.gitpath  gitpath:data/%.ssim  comment:Ssimfiles
dev.gitpath  gitpath:extern/%  comment:"Third-party files, taken as they come"
dev.gitpath  gitpath:include/%.h  comment:"C++ headers"
dev.gitpath  gitpath:lock/.empty  comment:"Keeps the lock directory in git"
dev.gitpath  gitpath:run/.empty  comment:"Keeps the run directory in git"
dev.gitpath  gitpath:run/.ffskip  comment:"Keeps ff out of the run directory"
dev.gitpath  gitpath:temp/.empty  comment:"Keeps the temp directory in git"
dev.gitpath  gitpath:temp/.ffskip  comment:"Keeps ff out of the temp directory"
dev.gitpath  gitpath:test/%  comment:"Test expectations, fixtures and test scripts"
dev.gitpath  gitpath:ts/%  comment:"TypeScript packages"
dev.gitpath  gitpath:txt/%.md  comment:Documentation
dev.gitpath  gitpath:www/%  comment:"Static web pages"
