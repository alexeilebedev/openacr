dev.extpkgprobe  extpkg:aws  probe:"command -v aws >/dev/null"  comment:""
dev.extpkgprobe  extpkg:buildkit  probe:"systemctl is-active --quiet buildkit"  comment:""
dev.extpkgprobe  extpkg:chrome  probe:"command -v google-chrome-stable >/dev/null"  comment:""
dev.extpkgprobe  extpkg:docker  probe:"systemctl is-active --quiet docker"  comment:""
dev.extpkgprobe  extpkg:gitlab_runner  probe:"gitlab-runner --version 2>/dev/null | grep -qF $VERSION"  comment:""
dev.extpkgprobe  extpkg:glow  probe:"command -v glow >/dev/null"  comment:""
dev.extpkgprobe  extpkg:go  probe:"command -v go >/dev/null"  comment:""
dev.extpkgprobe  extpkg:grpcurl  probe:"command -v grpcurl >/dev/null"  comment:""
dev.extpkgprobe  extpkg:java  probe:"/opt/java/current/bin/java -version 2>&1 | grep -qF $VERSION"  comment:""
dev.extpkgprobe  extpkg:jq  probe:"jq --version 2>/dev/null | grep -qF $VERSION"  comment:""
dev.extpkgprobe  extpkg:kafka  probe:"test -d /opt/kafka/versions/kafka_2.13-$VERSION"  comment:""
dev.extpkgprobe  extpkg:kcat  probe:'kcat -V 2>/dev/null | grep -qF "Version $VERSION "'  comment:""
dev.extpkgprobe  extpkg:librdkafka  probe:"grep -qsF 'Version: $VERSION' /usr/lib/pkgconfig/rdkafka.pc /usr/local/lib/pkgconfig/rdkafka.pc"  comment:""
dev.extpkgprobe  extpkg:linux_tools  probe:"test -x /usr/lib/linux-tools/$(uname -r)/cpupower"  comment:""
dev.extpkgprobe  extpkg:mc  probe:"command -v mc >/dev/null"  comment:""
dev.extpkgprobe  extpkg:minio  probe:"command -v minio >/dev/null"  comment:""
dev.extpkgprobe  extpkg:mosquitto  probe:"mosquitto_pub --help | grep -qF $VERSION"  comment:""
dev.extpkgprobe  extpkg:nats  probe:"command -v nats >/dev/null"  comment:""
dev.extpkgprobe  extpkg:nats_server  probe:"command -v nats-server >/dev/null"  comment:""
dev.extpkgprobe  extpkg:nerdctl  probe:"command -v nerdctl >/dev/null"  comment:""
dev.extpkgprobe  extpkg:nodejs  probe:"/opt/node/current/bin/node --version | grep -qF v$VERSION"  comment:""
dev.extpkgprobe  extpkg:ofed  probe:"dpkg -s doca-ofed-userspace libxlio >/dev/null 2>&1"  comment:""
dev.extpkgprobe  extpkg:ofed_kernel  probe:"dpkg -s doca-ofed >/dev/null 2>&1 && dkms status mlnx-ofed-kernel -k $(uname -r) | grep -q installed"  comment:""
dev.extpkgprobe  extpkg:osv_scanner  probe:"command -v osv-scanner >/dev/null"  comment:""
dev.extpkgprobe  extpkg:pnpm  probe:"pnpm --version 2>/dev/null | grep -qF $VERSION"  comment:""
dev.extpkgprobe  extpkg:redis  probe:"redis-cli --version | grep -qF $VERSION"  comment:""
dev.extpkgprobe  extpkg:rsync  probe:"rsync --version | grep -qF $VERSION"  comment:""
dev.extpkgprobe  extpkg:rust  probe:"command -v cargo >/dev/null && command -v rustfmt >/dev/null"  comment:""
dev.extpkgprobe  extpkg:shfmt  probe:"command -v shfmt >/dev/null"  comment:""
dev.extpkgprobe  extpkg:spdk  probe:"command -v spdk_tgt >/dev/null"  comment:""
dev.extpkgprobe  extpkg:tla  probe:"test -f /opt/tla/tla2tools-$VERSION.jar"  comment:""
dev.extpkgprobe  extpkg:tsc_freq_khz  probe:"test -r /sys/devices/system/cpu/cpu0/tsc_freq_khz"  comment:""
dev.extpkgprobe  extpkg:wstunnel  probe:"command -v wstunnel >/dev/null"  comment:""
