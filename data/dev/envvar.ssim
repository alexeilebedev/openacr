dev.envvar  envvar:ACR_COMPL_DEBUG_LOG  ours:Y  comment:"acr_compl writes its debug log here"
dev.envvar  envvar:ALGOFATALDIR  ours:Y  comment:"where a dying process writes its fatal report"
dev.envvar  envvar:ALGO_DIE_WITH  ours:Y  comment:"on macOS, <child>:<parent> pids; the child dies when the parent exits"
dev.envvar  envvar:ATF_UNIT_TSCFREQKHZ  ours:Y  comment:"cycle counter frequency a unit test pins"
dev.envvar  envvar:AWS_ACCESS_KEY_ID  ours:N  comment:"the AWS SDK and cli; set around one child"
dev.envvar  envvar:AWS_SECRET_ACCESS_KEY  ours:N  comment:"the AWS SDK and cli; set around one child"
dev.envvar  envvar:CI  ours:N  comment:"the runner says a job is running"
dev.envvar  envvar:CI_PROJECT_PATH  ours:N  comment:"the runner names the project"
dev.envvar  envvar:CI_SERVER_URL  ours:N  comment:"the runner names the gitlab server"
dev.envvar  envvar:COMP_LINE  ours:N  comment:"bash completion passes the line this way and no other"
dev.envvar  envvar:COMP_POINT  ours:N  comment:"bash completion passes the cursor this way and no other"
dev.envvar  envvar:COMP_TYPE  ours:N  comment:"bash completion passes the request type this way and no other"
dev.envvar  envvar:COWDANCER_SO  ours:N  comment:pbuilder
dev.envvar  envvar:CREDD_ASKPASS_ANSWER  ours:N  comment:"ssh's askpass protocol, so a passphrase never reaches a command line"
dev.envvar  envvar:CREDD_PASSWORD  ours:N  comment:"credd master password, for a comptest or a person shell rc"
dev.envvar  envvar:DEBIAN_FRONTEND  ours:N  comment:"apt; the node scripts export it so a package install asks nothing"
dev.envvar  envvar:EDITOR  ours:N  comment:"the convention every tool with -e follows"
dev.envvar  envvar:GCC_PROFILE_DIR  ours:Y  comment:"where a coverage run writes its profile"
dev.envvar  envvar:GITLAB_API_TOKEN  ours:N  comment:"a protected CI variable is how a secret reaches a job without a file in git"
dev.envvar  envvar:GITLAB_CI  ours:N  comment:"the runner says a job is running"
dev.envvar  envvar:GIT_AUTHOR_DATE  ours:N  comment:"git, so a sandbox commit has a fixed date and a stable hash"
dev.envvar  envvar:GIT_AUTHOR_EMAIL  ours:N  comment:"git, so a sandbox commit has an author"
dev.envvar  envvar:GIT_AUTHOR_NAME  ours:N  comment:"git, so a sandbox commit has an author"
dev.envvar  envvar:GIT_COMMITTER_DATE  ours:N  comment:"git, so a sandbox commit has a fixed date and a stable hash"
dev.envvar  envvar:GIT_COMMITTER_EMAIL  ours:N  comment:"git, so a sandbox commit has an author"
dev.envvar  envvar:GIT_COMMITTER_NAME  ours:N  comment:"git, so a sandbox commit has an author"
dev.envvar  envvar:GIT_DIR  ours:N  comment:"git; which repository a command acts on"
dev.envvar  envvar:GIT_SSH_COMMAND  ours:N  comment:"git; the command it reaches an ssh remote through, so a test can serve one from disk"
dev.envvar  envvar:GIT_WORK_TREE  ours:N  comment:"git; which working tree a command acts on"
dev.envvar  envvar:HOME  ours:N  comment:"the operating system"
dev.envvar  envvar:LD_PRELOAD  ours:N  comment:"the loader; a supervisor sets it around a child"
dev.envvar  envvar:OMENV  ours:Y  comment:"which om environment a run acts on"
dev.envvar  envvar:OMUSER  ours:Y  comment:"which user a run acts as"
dev.envvar  envvar:PATH  ours:N  comment:"the operating system; the relative entry bin is what this tree relies on"
dev.envvar  envvar:PORT  ours:N  comment:"a dev server"
dev.envvar  envvar:SSH_AUTH_SOCK  ours:N  comment:"ssh; credd sets it so its agent is the one ssh finds"
dev.envvar  envvar:STUB_AI_CMD  ours:Y  comment:"a command the ai stub runs before the build ends, so a test can push to the branch mid-build"
dev.envvar  envvar:STUB_AI_MSG  ours:Y  comment:"what the ai stub prints before it fails"
dev.envvar  envvar:STUB_AI_RC  ours:Y  comment:"the exit code the ai stub returns"
dev.envvar  envvar:STUB_AI_SLEEP  ours:Y  comment:"how long the ai stub takes, so a test can drive a slow build"
dev.envvar  envvar:STUB_CLAUDE_BLOCKED  ours:Y  comment:"how many listings the claude stub reads its job as blocked on its agents in"
dev.envvar  envvar:STUB_CLAUDE_CLOSE  ours:Y  comment:"the claude stub closes the merge request instead of reviewing it"
dev.envvar  envvar:STUB_CLAUDE_FAILED  ours:Y  comment:"the claude stub lists its session as failed, a session that gave up, and writes nothing"
dev.envvar  envvar:STUB_CLAUDE_NOLIST  ours:Y  comment:"the claude stub fails every job listing, a job list that cannot be read"
dev.envvar  envvar:STUB_CLAUDE_PROMPT  ours:Y  comment:"the file the claude stub writes the prompt of its session to"
dev.envvar  envvar:STUB_CLAUDE_RETRO  ours:Y  comment:"listings the claude stub reads as done after a resume, before the retrospective starts"
dev.envvar  envvar:STUB_CLAUDE_SETTINGS  ours:Y  comment:"the file the claude stub writes the settings of its session to"
dev.envvar  envvar:STUB_CLAUDE_STALE  ours:Y  comment:"the merge request whose earlier round the claude stub lists as a job still at work"
dev.envvar  envvar:STUB_CLAUDE_SUMMARY  ours:Y  comment:"how many threads the claude stub reports in its summary"
dev.envvar  envvar:STUB_CLAUDE_TRIAGE  ours:Y  comment:"how many issues the claude stub reports judged in its triage note"
dev.envvar  envvar:STUB_FLOCK_RC  ours:Y  comment:"the exit code the flock stub returns, so a test can refuse the build lock"
dev.envvar  envvar:STUB_GLI_LOST  ours:Y  comment:"the gliflaky stub posts each summary and then reports it timed out"
dev.envvar  envvar:STUB_GLI_NODISCUSS  ours:Y  comment:"the merge request whose discussion reads the gliflaky stub fails"
dev.envvar  envvar:STUB_GLI_NOME  ours:Y  comment:"the gliflaky stub drops the account from each discussion header"
dev.envvar  envvar:STUB_GLI_REAL  ours:Y  comment:"the gli the gliflaky stub of a reviewd comptest runs"
dev.envvar  envvar:STUB_GLI_SEEN  ours:Y  comment:"the gliflaky stub fails each discussion read after one that held a triage note"
dev.envvar  envvar:STUB_GLI_TIMEOUT  ours:Y  comment:"how many summary posts the gliflaky stub fails as timed out, posting nothing"
dev.envvar  envvar:STUB_SSH_ROOT  ours:Y  comment:"the directory the ssh stub serves a remote path from"
dev.envvar  envvar:SUDO_USER  ours:N  comment:"sudo; who invoked a privileged run"
dev.envvar  envvar:TERM  ours:N  comment:"the operating system"
dev.envvar  envvar:TMPDIR  ours:N  comment:"the operating system"
dev.envvar  envvar:TZ  ours:N  comment:"the operating system"
dev.envvar  envvar:USER  ours:N  comment:"the operating system; every read is who is running this, which a -user option overrides"
dev.envvar  envvar:VISUAL  ours:N  comment:"the convention every tool with -e follows"
