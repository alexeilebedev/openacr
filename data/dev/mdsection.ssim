dev.mdsection  mdsection:Title  match:"## %"  path:%  genlist:""  comment:"Page Title"
dev.mdsection  mdsection:Syntax  match:"### Syntax"  path:txt/exe/%/README.md  genlist:""  comment:"Command syntax"
dev.mdsection  mdsection:Description  match:"### Description"  path:%README.md  genlist:""  comment:"Namespace description"
dev.mdsection  mdsection:Limitations  match:"### Limitations"  path:""  genlist:""  comment:"Tool limitations"
dev.mdsection  mdsection:Content  match:"### ---"  path:""  genlist:""  comment:"Any other content (hard-coded)"
dev.mdsection  mdsection:Example  match:"### Example%"  path:""  genlist:""  comment:"User-provided example"
dev.mdsection  mdsection:Options  match:"### Options"  path:txt/exe/%/README.md  genlist:"####"  comment:"List of command-line options"
dev.mdsection  mdsection:Copyright  match:"### Copyright"  path:""  genlist:""  comment:"(gen) Copyright information"
