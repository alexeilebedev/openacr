dev.extpkg  extpkg:aws  probe:"command -v aws >/dev/null"  comment:"aws command line client, version 2"
dev.extpkg  extpkg:buildkit  probe:"systemctl is-active --quiet buildkit"  comment:"buildkit daemon and client, the builder nerdctl drives"
dev.extpkg  extpkg:certbot  probe:""  comment:"lets encrypt client, installed into its own venv"
dev.extpkg  extpkg:chrome  probe:"command -v google-chrome-stable >/dev/null"  comment:"headless chrome from the vendor apt repository"
dev.extpkg  extpkg:docker  probe:"systemctl is-active --quiet docker"  comment:"docker engine from the vendor apt repository"
dev.extpkg  extpkg:gitlab_runner  probe:""  comment:"gitlab ci runner"
dev.extpkg  extpkg:glow  probe:"command -v glow >/dev/null"  comment:"markdown renderer for the terminal"
dev.extpkg  extpkg:go  probe:"command -v go >/dev/null"  comment:"the go toolchain from the upstream tarball"
dev.extpkg  extpkg:grpcurl  probe:"command -v grpcurl >/dev/null"  comment:"grpc command line client"
dev.extpkg  extpkg:kafka  probe:""  comment:"apache kafka broker and its jmx exporter"
dev.extpkg  extpkg:kafka_connectors  probe:""  comment:"s3 and iceberg connectors for kafka connect"
dev.extpkg  extpkg:kafkaui  probe:""  comment:"web console for kafka"
dev.extpkg  extpkg:kcat  probe:"command -v kcat >/dev/null"  comment:"kafka producer and consumer for the command line"
dev.extpkg  extpkg:kdi  probe:""  comment:"kafka delta ingest, built from a pinned commit"
dev.extpkg  extpkg:librdkafka  probe:""  comment:"c kafka client library"
dev.extpkg  extpkg:linux_tools  probe:"test -x /usr/lib/linux-tools/$(uname -r)/cpupower"  comment:"cpupower and the kernel tools of the running kernel"
dev.extpkg  extpkg:mc  probe:"command -v mc >/dev/null"  comment:"minio client"
dev.extpkg  extpkg:minio  probe:"command -v minio >/dev/null"  comment:"s3 compatible object store"
dev.extpkg  extpkg:nats  probe:"command -v nats >/dev/null"  comment:"nats command line client"
dev.extpkg  extpkg:nats_server  probe:"command -v nats-server >/dev/null"  comment:"nats-server broker, jetstream capable"
dev.extpkg  extpkg:nerdctl  probe:"command -v nerdctl >/dev/null"  comment:"containerd command line client, with buildkit"
dev.extpkg  extpkg:nodejs  probe:""  comment:"node from the nodesource apt repository, plus pnpm"
dev.extpkg  extpkg:oauth2_proxy  probe:""  comment:"reverse proxy that authenticates against an oidc provider"
dev.extpkg  extpkg:ofed  probe:"dpkg -s ofed-scripts >/dev/null 2>&1"  comment:"mellanox ofed user space stack"
dev.extpkg  extpkg:postgresql  probe:""  comment:"postgresql server and client, with no auto-created cluster"
dev.extpkg  extpkg:redpanda  probe:""  comment:"redpanda broker from the vendor apt repository"
dev.extpkg  extpkg:rust  probe:"command -v cargo >/dev/null && command -v rustfmt >/dev/null"  comment:"the rust toolchain from static.rust-lang.org: rustc, cargo, the standard library, rustfmt and clippy"
dev.extpkg  extpkg:shfmt  probe:"command -v shfmt >/dev/null"  comment:"shell formatter"
dev.extpkg  extpkg:spark  probe:""  comment:"delta, hadoop-aws and postgres jars for the spark image"
dev.extpkg  extpkg:spdk  probe:"command -v spdk_tgt >/dev/null"  comment:"storage performance development kit"
dev.extpkg  extpkg:ssm_plugin  probe:""  comment:"aws session manager plugin"
dev.extpkg  extpkg:tsc_freq_khz  probe:"test -r /sys/devices/system/cpu/cpu0/tsc_freq_khz"  comment:"kernel module exporting the tsc frequency"
dev.extpkg  extpkg:vma  probe:""  comment:"mellanox libvma, built from the release tag"
dev.extpkg  extpkg:wstunnel  probe:"command -v wstunnel >/dev/null"  comment:"tunnel tcp over websocket"
