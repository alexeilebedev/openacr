atfdb.comptest  comptest:amc.GstaticBadLine  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate a gstatic table with a broken second line, and check that amc names the file and line and loads the rest"
