atfdb.comptest  comptest:amc.ArgvGlobal  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate an Argv cfmt on a global and a regular ctype, and check the PrintArgv and ToArgv bodies of each"
atfdb.comptest  comptest:amc.ArgvGnu  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate an ArgvGnu cfmt, and check the -x and --name tokens and the separate values in PrintArgv and ToArgv"
atfdb.comptest  comptest:amc.BadArgvRead  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate argv readers for a table of cfmt shapes, and check that amc rejects each shape whose companions disagree"
atfdb.comptest  comptest:amc.BadBigendDeadend  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Give amc an fbigend field on a type whose bltin row withholds bigendok, and check that amc rejects it"
