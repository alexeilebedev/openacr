atfdb.comptest  comptest:acr.FileModCount  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Insert rows of two ssimfiles with acr -insert -write, and check that n_file_mod counts both files"
