atfdb.comptest  comptest:acr.BadReftype  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Insert a field with no reftype under acr -insert -check, and check the error acr reports"
atfdb.comptest  comptest:acr.CascDel  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Delete a namespace with acr -del, and check that its ctype and field go with it"
