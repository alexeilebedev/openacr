atfdb.comptest  comptest:amc.JsonGlobal  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate FmtJson on global ctypes and ctypes with no data, and check the parentless calls and empty objects"
