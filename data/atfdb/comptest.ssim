atfdb.comptest  comptest:acr.CascDel3  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Feed an acr.delete of a Base field to acr -replace, and check the row it deletes"
atfdb.comptest  comptest:acr.DelField  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Delete field dmmeta.Ns.license with acr -del, and check that the xrefs through it go too"
atfdb.comptest  comptest:acr.DelRecord  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Delete a target with acr -del, and check that its targdep and targsrc rows go with it"
atfdb.comptest  comptest:acr.DeleteReinsert  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Delete and reinsert namespace amc in one acr -insert, and check that acr reports one update"
