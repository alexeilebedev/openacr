atfdb.comptest  comptest:amc.BadBigendU128  timeout:10  cijob:compB  memcheck:none  coverage:Y  stablefld:N  comment:"Give amc an fbigend u128 field, and check that amc rejects it for want of a byteswap primitive"
atfdb.comptest  comptest:amc.BadBitfldReftype  timeout:10  cijob:compB  memcheck:none  coverage:Y  stablefld:N  comment:"Give amc fields for each pairing of reftype Bitfld and a dmmeta.bitfld row, and check both mismatches"
atfdb.comptest  comptest:amc.BadBitsetElem  timeout:10  cijob:compB  memcheck:none  coverage:Y  stablefld:N  comment:"Give amc a bitset over a 72-bit Smallstr element, and check that amc rejects the element"
