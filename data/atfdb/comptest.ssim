atfdb.comptest  comptest:amc.GsymbolBadline  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate a gsymbol table with two broken lines, and check that amc names each file and line and exits nonzero"
atfdb.comptest  comptest:amc.GsymbolLoadFail  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate a gsymbol whose table is missing, and check that amc names the file and exits nonzero"
atfdb.comptest  comptest:amc.GsymbolSideload  timeout:10  cijob:compB  memcheck:none  coverage:Y  stablefld:N  comment:"Generate a gsymbol in a single-file universe, and check that amc prints the amc.sideload notice for data/"
atfdb.comptest  comptest:amc.JsFixedFrame  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate TypeScript encoders for a fixed-size and a varlen frame, and check that only the varlen one has a guard"
atfdb.comptest  comptest:amc.JsonAry  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate FmtJson for every rendering shape and for fields named like locals, and check each emitted body"
