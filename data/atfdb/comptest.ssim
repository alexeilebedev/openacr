atfdb.comptest  comptest:acr_dm.Conflict  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Merge two files that change one row two ways, and check the conflict markers and the exit code 1"
atfdb.comptest  comptest:acr_dm.DeepRun  timeout:60  cijob:compB  memcheck:none  coverage:Y  stablefld:N  comment:"Merge a 100K-row file that one side adds whole, and check that every row comes out"
atfdb.comptest  comptest:acr_dm.FieldOrder  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Merge a field added at the top with one appended at the bottom, and check that each stays where it was made"
atfdb.comptest  comptest:acr_dm.Merge  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Merge two files that change different rows, and check the merged rows"
atfdb.comptest  comptest:acr_dm.MergeFail  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Merge with a third file that is missing, and check that acr_dm prints both present files between markers and exits 1"
atfdb.comptest  comptest:acr_dm.MoveConflict  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Merge two files that move one row to two places, and check the conflict and that the rebase leaves the same rows"
atfdb.comptest  comptest:acr_dm.RenameTuple  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Merge a side that deletes a row with a side that renames it, and check that the renamed row survives"
atfdb.comptest  comptest:acr_dm.Reorder  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Merge an upstream reorder with an appended field, and check that both survive and the rebase gives the same file"
atfdb.comptest  comptest:acr_dm.Symmetry  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Merge two runs added at one place, then rebase with the sides swapped, and check that both give the same file"
atfdb.comptest  comptest:acr_ed.CreateCtype  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Create ctype ams.ChildTypeMsg with acr_ed -create -msgtype:400 -reftype:Base, and check the script it prints"
atfdb.comptest  comptest:acr_ed.CreateMsg  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:Y  comment:"Create message ams.AbcMsg with acr_ed -create, and check the script it prints"
atfdb.comptest  comptest:acr_ed.CreateSrcfileTarget  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Create cpp/acr_ed/blah.cpp for target algo_lib with acr_ed -create, and check the script it prints"
atfdb.comptest  comptest:acr_ed.CreateSsimfile  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Create ssimfile dmmeta.xyz with acr_ed -create, and check the script it prints"
atfdb.comptest  comptest:acr_ed.CreateSsimfileBadNs  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Create ssimfile ams.test with acr_ed, and check that it refuses a namespace missing from dmmeta.nsdb"
atfdb.comptest  comptest:acr_ed.CreateTarget  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Create target xyz with acr_ed -create, and check the script it prints"
atfdb.comptest  comptest:acr_ed.DelField  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Delete a field of an ssim ctype and of an in-memory ctype with acr_ed, and check that only the first rewrites a file"
atfdb.comptest  comptest:acr_ed.RenameField  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Rename fields with acr_ed, and check that it resolves a bare name and refuses a query prefix or a new ssim ctype"
atfdb.comptest  comptest:acr_in.Reverse  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"Run acr_in -r dev.targdep, and check the targets it lists as readers of the table"
atfdb.comptest  comptest:acr_in.Simple  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"List the inputs of the acr_in target with acr_in, and check the ssimfiles and dispsigs it prints"
atfdb.comptest  comptest:acr_in.Tree  timeout:10  cijob:compB  memcheck:memcheckC  coverage:Y  stablefld:N  comment:"List the inputs of the acr_in target with acr_in -t, and check the tree it prints"
atfdb.comptest  comptest:amc.ArgvAccessor  timeout:10  cijob:compB  memcheck:memcheckB  coverage:Y  stablefld:N  comment:"Generate an Argv and an ArgvGnu ctype over one set of fields, and check which argv accessors each one gets"
