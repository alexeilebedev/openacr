atfdb.comptest  comptest:amc.BadCascdelNopool  timeout:10  cijob:compB  memcheck:none  coverage:Y  stablefld:N  comment:"Give amc a cascdel Ptrary whose row ctype has no pool, and check that amc rejects it"
