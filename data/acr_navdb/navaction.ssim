acr_navdb.navaction  navaction:filter_accept  hint:""  comment:"Accept filter and return to browse mode"
acr_navdb.navaction  navaction:filter_append_space  hint:""  comment:"Append space to filter text"
acr_navdb.navaction  navaction:filter_backspace  hint:""  comment:"Delete last filter character"
acr_navdb.navaction  navaction:filter_cancel  hint:""  comment:"Cancel filter input"
acr_navdb.navaction  navaction:filter_clear  hint:""  comment:"Clear filter text"
acr_navdb.navaction  navaction:filter_start  hint:filter  comment:"Enter filter input mode"
acr_navdb.navaction  navaction:follow_ref  hint:follow  comment:"Follow reference to target ctype"
acr_navdb.navaction  navaction:go_back  hint:back  comment:"Return to previous ctype"
acr_navdb.navaction  navaction:go_bottom  hint:""  comment:"Move selection to last item"
acr_navdb.navaction  navaction:go_top  hint:""  comment:"Move selection to first item"
acr_navdb.navaction  navaction:move_down  hint:move  comment:"Move selection down"
acr_navdb.navaction  navaction:move_up  hint:move  comment:"Move selection up"
acr_navdb.navaction  navaction:page_down  hint:page  comment:"Move selection down one page"
acr_navdb.navaction  navaction:page_up  hint:page  comment:"Move selection up one page"
acr_navdb.navaction  navaction:quit  hint:quit  comment:"Exit acr_nav"
acr_navdb.navaction  navaction:show_help  hint:help  comment:"Toggle help overlay"
acr_navdb.navaction  navaction:switch_panel_left  hint:""  comment:"Move focus to panel on the left"
acr_navdb.navaction  navaction:switch_panel_right  hint:""  comment:"Move focus to panel on the right"
acr_navdb.navaction  navaction:toggle_xref  hint:xref  comment:"Toggle right panel between fields and reverse xrefs"
