#!/bin/bash
# A compiler driver that compiles nothing, for gcache's comptests.
# gcache decides the format of a cache entry from the flags on the command
# line, and a test of that decision through a real compiler can only use the
# spellings that compiler accepts: --test-coverage and --profile-arcs are
# gcc's own long forms, and clang refuses them.  This driver accepts every
# flag, so the test reads gcache's classification of a spelling and nothing
# about the compiler behind it.
# Under -E the source named on the command line is copied to the -o output
# with one level of #include expanded the way gcc marks it -- `# 1 "h.h" 1`
# before the header's lines and `# N "src" 2` after them -- which is what
# gcache reads as the preprocessed text and walks for a header to precompile.
# Otherwise the output is written as an object of a few bytes, and a notes
# file is written beside it whatever the flags say, so the notes come back
# from a cache hit exactly when gcache filed the entry in the coverage format.
# An output named .gch is a precompiled header: it is written and no notes
# are, since a header compiles to no object.
# gcache asks a compiler whether it is clang with -dM, and the driver answers
# with the macros it predefines: __clang__ among them when it is run through a
# link named clang++.  Run that way it compiles from the source, as gcache has
# clang do, and its object names the source.  A source named edit.cpp is edited
# while it compiles, so the text the object comes from is not the text gcache
# hashed, which is the case gcache must not file under the old key.
mode=compile
out=""
src=""
while test $# -gt 0; do
    case "$1" in
        -E) test "$mode" = macros || mode=preprocess;;
        -dM) mode=macros;;
        -o) out="$2"; shift;;
        *.cpp) src="$1";;
    esac
    shift
done
if test "$mode" = macros; then
    echo "#define __cplusplus 201703L"
    test "$(basename "$0")" = clang++ && echo "#define __clang__ 1"
    exit 0
elif test "$mode" = preprocess; then
    awk -v src="$src" '
        BEGIN { print "# 1 \"" src "\"" }
        /^#include[ \t]+[<"][^>"]+[>"]/ {
            inc = $0
            sub(/^#include[ \t]+[<"]/, "", inc)
            sub(/[>"].*$/, "", inc)
            print "# 1 \"" inc "\" 1"
            while ((getline line < inc) > 0) { print line }
            close(inc)
            print "# " NR+1 " \"" src "\" 2"
            next
        }
        { print }' "$src" > "$out"
else
    case "$out" in
        *.gch) echo pch > "$out";;
        *)
            if test "$(basename "$0")" = clang++; then
                echo "object from $src" > "$out"
            else
                echo object > "$out"
            fi
            test "$(basename "$src")" = edit.cpp && echo "// edited during the compile" >> "$src"
            echo notes > "${out%.*}.gcno";;
    esac
fi
