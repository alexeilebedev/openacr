dmmeta.field  field:algo_lib.Rec.byte  arg:u8  reftype:Val  dflt:""  comment:"store is the whole arg type"
dmmeta.fconst  fconst:algo_lib.Rec.byte/argmax  value:255  comment:"the arg type's own maximum fits"
dmmeta.fconst  fconst:algo_lib.Rec.byte/past  value:300  comment:"past the arg type's maximum"
dmmeta.fconst  fconst:algo_lib.Rec.byte/plus  value:+255  comment:"a leading plus belongs to the number"
dmmeta.fconst  fconst:algo_lib.Rec.byte/suffix  value:255u  comment:"a type suffix is not part of the number"
dmmeta.fconst  fconst:algo_lib.Rec.byte/suffixpast  value:300ull  comment:"past the maximum, suffix and all"
dmmeta.fconst  fconst:algo_lib.Rec.byte/octal  value:0377  comment:"a leading zero is octal: 255 fits"
dmmeta.fconst  fconst:algo_lib.Rec.byte/octalpast  value:0400  comment:"octal 400 is 256, past the maximum"
dmmeta.fconst  fconst:algo_lib.Rec.byte/arith  value:"1000-999"  comment:"an expression: nothing to compare"
dmmeta.fconst  fconst:algo_lib.Rec.byte/shift  value:"1<<40"  comment:"a shift expression: nothing to compare"
dmmeta.fconst  fconst:algo_lib.Rec.byte/trail  value:300ms  comment:"digits with trailing text: no number to compare"
dmmeta.fconst  fconst:algo_lib.Rec.byte/char  value:"'A'"  comment:"a character literal: nothing to compare"
dmmeta.fconst  fconst:algo_lib.Rec.byte/name  value:UCHAR_MAX  comment:"a name only the compiler resolves"
dmmeta.fconst  fconst:algo_lib.Rec.byte/binary  value:0b100000000  comment:"a binary literal is a spelling amc does not read"
dmmeta.field  field:algo_lib.Rec.snum  arg:i32  reftype:Val  dflt:""  comment:"store is the whole arg type"
dmmeta.fconst  fconst:algo_lib.Rec.snum/argmin  value:-2147483648  comment:"the arg type's own minimum fits"
dmmeta.fconst  fconst:algo_lib.Rec.snum/past  value:2147483648  comment:"past the signed arg type's maximum"
dmmeta.fconst  fconst:algo_lib.Rec.snum/hexmin  value:-0x80000000  comment:"the minimum, spelled as a signed hex literal"
dmmeta.fconst  fconst:algo_lib.Rec.snum/hexpast  value:-0x80000001  comment:"one past the minimum, spelled in hex"
dmmeta.field  field:algo_lib.Rec.full  arg:u64  reftype:Val  dflt:""  comment:"store is the whole 64-bit arg type"
dmmeta.fconst  fconst:algo_lib.Rec.full/argmax  value:18446744073709551615  comment:"the arg type's own maximum fits"
dmmeta.fconst  fconst:algo_lib.Rec.full/highbit  value:0x8000000000000000  comment:"past the signed maximum, and an unsigned store holds it"
dmmeta.fconst  fconst:algo_lib.Rec.full/hexmax  value:0xffffffffffffffff  comment:"the arg type's maximum, spelled in hex"
dmmeta.fconst  fconst:algo_lib.Rec.full/hexwide  value:0x10000000000000001  comment:"a magnitude past 64 bits fits no store"
dmmeta.fconst  fconst:algo_lib.Rec.full/decwide  value:99999999999999999999999  comment:"a decimal magnitude past 64 bits fits no store"
dmmeta.field  field:algo_lib.Rec.narrow  arg:u32  reftype:Bitfld  dflt:""  comment:"bits hold less than the arg type"
dmmeta.bitfld  field:algo_lib.Rec.narrow  offset:0  width:10  srcfield:algo_lib.Rec.word  comment:""
dmmeta.fconst  fconst:algo_lib.Rec.narrow/maxstore  value:1023  comment:"the widest value the bits hold"
dmmeta.fconst  fconst:algo_lib.Rec.narrow/past  value:2000  comment:"past the bits, would be stored masked"
dmmeta.field  field:algo_lib.Rec.sig_edge  arg:algo_lib.Sig8  reftype:Bitfld  dflt:""  comment:"bits drop the arg type's sign"
dmmeta.bitfld  field:algo_lib.Rec.sig_edge  offset:10  width:7  srcfield:algo_lib.Rec.word  comment:""
dmmeta.fconst  fconst:algo_lib.Rec.sig_edge/maxstore  value:127  comment:"the widest value the bits hold"
dmmeta.fconst  fconst:algo_lib.Rec.sig_edge/negative  value:-1  comment:"the bits drop the sign, so no negative fits"
dmmeta.field  field:algo_lib.Rec.sig_full  arg:algo_lib.Sig8  reftype:Bitfld  dflt:""  comment:"bits span the whole arg type"
dmmeta.bitfld  field:algo_lib.Rec.sig_full  offset:17  width:8  srcfield:algo_lib.Rec.word  comment:""
dmmeta.fconst  fconst:algo_lib.Rec.sig_full/argmin  value:-128  comment:"the bits keep the sign, so the arg minimum fits"
dmmeta.fconst  fconst:algo_lib.Rec.sig_full/hexmin  value:-0x80  comment:"the arg minimum, spelled as a signed hex literal"
