# start mdbg cmd:"$bindir/mdbg -dry_run mdbg mdbg"
# eof mdbg
mdbg -> bin/abt  -target:mdbg -cfg:debug
mdbg -> #Gdb script is shown below
mdbg -> # This file was generated by mdbg
mdbg -> set history filename temp/gdb.history
mdbg -> set history save on
mdbg -> set debuginfod enabled off
mdbg -> set record instruction-history-size 1000000
mdbg -> set record function-call-history-size 100000
mdbg -> set record function-call-history 1000
mdbg -> set confirm off
mdbg -> handle all nostop noprint pass
mdbg -> handle SIGSEGV SIGBUS stop print nopass
mdbg -> set pagination off
mdbg -> catch throw
mdbg -> file build/debug/mdbg
mdbg -> set args mdbg
mdbg -> start
mdbg -> break main
mdbg -> break algo::FatalErrorExit
mdbg -> mdbg.note  Debug script saved to temp/mdbg.el
mdbg -> mdbg.note  Invoking gdb under emacs. Make sure to link ~/.emacs -> conf/emacs.el, ~/elisp -> conf/elisp
mdbg -> mdbg.note  Standard shortcuts:
mdbg -> mdbg.note               F7  recompile and restart executable
mdbg -> mdbg.note              F11  step into
mdbg -> mdbg.note        Shift-F11  step out
mdbg -> mdbg.note              F10  step over
mdbg -> mdbg.note         Ctrl-F10  run to cursor
mdbg -> mdbg.note              F12  restore windows
mdbg -> mdbg.note              F9   set breakpoint
mdbg -> mdbg.note         Ctrl-F9   clear breakpoint
mdbg -> mdbg.note              F6   other window
mdbg -> mdbg.note    Alt-Up Arrow   Go up the call stack
mdbg -> mdbg.note  Alt-Down Arrow   Go down the call stack
mdbg -> # Emacs script is shown below
mdbg -> ; 
mdbg -> ; This file was generated by mdbg
mdbg -> (defun gdb-restore-windows-full () (interactive)
mdbg ->   (gdb-restore-windows)
mdbg ->   )
mdbg -> (defun gdb-send-input (string) (interactive)
mdbg ->   (let ((old-buffer (current-buffer)))
mdbg ->     (switch-to-buffer "*gud*")
mdbg ->     (insert string)
mdbg ->     (comint-send-input)
mdbg ->     (switch-to-buffer old-buffer)
mdbg ->     ))
mdbg -> (defun gdb-send-input-ui (string) (interactive)
mdbg ->   (gdb-restore-windows-full)
mdbg ->   (insert string)
mdbg ->   (comint-send-input)
mdbg ->   )
mdbg -> (defun gdb-remote-output (process output)
mdbg ->   (let ((old-buffer (current-buffer)))
mdbg ->     (switch-to-buffer "*gud*")
mdbg ->     (insert output)
mdbg ->     (comint-set-process-mark)
mdbg ->     (switch-to-buffer old-buffer)
mdbg ->     ))
mdbg -> (defun mdbg-recompile   () (interactive)
mdbg ->   (gdb-send-input-ui "!abt mdbg -cfg debug")
mdbg ->   (gdb-send-input-ui "run"))
mdbg -> (defun mdbg-step   () (interactive) (gdb-send-input-ui "step"))
mdbg -> (defun mdbg-next   () (interactive) (gdb-send-input-ui "next"))
mdbg -> (defun mdbg-finish () (interactive) (gdb-send-input-ui "finish"))
mdbg -> (defun mdbg-until  () (interactive) (gdb-send-input-ui "until"))
mdbg -> (defun mdbg-cont   () (interactive) (gdb-send-input-ui "cont"))
mdbg -> (defun mdbg-break  () (interactive) (gdb-send-input (concat "break " (buffer-name) ":" (number-to-string (line-number-at-pos)))))
mdbg -> (defun mdbg-clear  () (interactive) (gdb-send-input (concat "clear " (buffer-name) ":" (number-to-string (line-number-at-pos)))))
mdbg -> (defun mdbg-up     () (interactive) (gdb-send-input-ui "up"))
mdbg -> (defun mdbg-down   () (interactive) (gdb-send-input-ui "down"))
mdbg -> (global-set-key (kbd "<f7>")      'mdbg-recompile)   ; rebuild program being debugged
mdbg -> (global-set-key (kbd "<f11>")     'mdbg-step)   ;step into
mdbg -> (global-set-key (kbd "S-<f11>")   'mdbg-finish) ;step out of function
mdbg -> (global-set-key (kbd "<f10>")     'mdbg-next)   ;step over
mdbg -> (global-set-key (kbd "C-<f10>")   'mdbg-until)  ;go until current line
mdbg -> (global-set-key (kbd "<f5>")      'mdbg-cont) ;run
mdbg -> (global-set-key (kbd "<f9>")      'mdbg-break) ;set breakpoint
mdbg -> (global-set-key (kbd "C-<f9>")    'mdbg-clear) ;clear breakpoint
mdbg -> (global-set-key (kbd "M-<down>")  'mdbg-down)
mdbg -> (global-set-key (kbd "M-<up>")  'mdbg-up)
mdbg -> (global-set-key (kbd "<f6>")      'other-window)
mdbg -> (global-set-key (kbd "<f12>")     'gdb-restore-windows-full)
mdbg -> (setq gdb-debuginfod-enable-setting "set debuginfod enabled off")
mdbg -> (gdb "gdb -i=mi --init-command=temp/mdbg.gdb")
# exit mdbg code:0
