amc -> // --- pbt.Msg.val.FieldMaskQ
amc -> // Return true if the field is marked in the presence mask
amc -> inline bool pbt::val_FieldMaskQ(pbt::Msg& parent) {
amc ->     return field_mask_qGetBit(parent, 0);
amc -> }
amc -> // --- pbt.Msg.val.SetFieldMask
amc -> // Set presence bit for this field in the pmask
amc -> inline void pbt::val_SetFieldMask(pbt::Msg& parent) {
