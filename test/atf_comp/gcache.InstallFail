# stage nodir
# start gcache cmd:"cd $tempdir && $$OLDPWD/$bindir/gcache -install -dir:nofile/cache"
gcache -> setting up gcache...
gcache -> gcache.error  file:nofile/cache/.keep  err:***  comment:"cache directory marker could not be written"
# eof gcache
# exit gcache code:1
# stage linkdir
# start gcache-2 cmd:"cd $tempdir && $$OLDPWD/$bindir/gcache -install -dir:cache"
gcache-2 -> setting up gcache...
gcache-2 -> gcache.error  file:.gcache  err:***  comment:"cache link could not be created"
# eof gcache-2
# exit gcache-2 code:1
# stage disabledir
# start gcache-3 cmd:"cd $tempdir && $$OLDPWD/$bindir/gcache -disable"
gcache-3 -> gcache.error  file:.gcache  err:***  comment:"cache link could not be removed"
# eof gcache-3
# exit gcache-3 code:1
# stage control
# start gcache-4 cmd:"cd $tempdir && $$OLDPWD/$bindir/gcache -install -dir:cache"
gcache-4 -> setting up gcache...
gcache-4 -> done
# eof gcache-4
# exit gcache-4 code:0
# check control_link:present
