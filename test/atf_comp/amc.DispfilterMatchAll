amc -> bool algo_lib::DispFilter_MatchEv(algo_lib::DispFilter &parent, algo_lib::Ev &msg) {
amc ->     bool ret = true;
amc ->     tempstr fieldstr;
amc ->     if (state_PresentQ(parent) && !(msg.state == parent.state)) {
amc ->         return false;
amc ->     }
amc ->     if (state_regx_PresentQ(parent)) {
amc ->         ch_RemoveAll(fieldstr);
amc ->         algo_lib::state_Print(msg, fieldstr);
amc ->         if (!algo_lib::Regx_Match(parent.state_regx, fieldstr)) {
amc ->             return false;
amc ->         }
amc ->     }
amc ->     if (start_state_PresentQ(parent) && msg.state < parent.start_state) {
amc ->         return false;
amc ->     }
amc ->     if (end_state_PresentQ(parent) && parent.end_state < msg.state) {
amc ->         return false;
amc ->     }
amc ->     if (seqno_PresentQ(parent) && !(seqno_Get(msg) == parent.seqno)) {
amc ->         return false;
amc ->     }
amc ->     if (start_seqno_PresentQ(parent) && seqno_Get(msg) < parent.start_seqno) {
amc ->         return false;
amc ->     }
amc ->     if (end_seqno_PresentQ(parent) && parent.end_seqno < seqno_Get(msg)) {
amc ->         return false;
amc ->     }
amc ->     // if field present in filter but not a member of ctype, return not filtered
amc ->     if (start_other_PresentQ(parent)) {
amc ->         return false;
amc ->     }
amc ->     // if field present in filter but not a member of ctype, return not filtered
amc ->     if (end_other_PresentQ(parent)) {
amc ->         return false;
amc ->     }
amc ->     // if field present in filter but not a member of ctype, return not filtered
amc ->     if (other_PresentQ(parent)) {
amc ->         return false;
amc ->     }
amc ->     return ret;
amc -> }
