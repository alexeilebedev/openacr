amc ->         return false;
amc ->     }
amc ->     if (seqno_PresentQ(parent) && !(seqno_Get(msg) == parent.seqno)) {
amc ->         return false;
amc ->     }
amc ->     if (start_seqno_PresentQ(parent) && seqno_Get(msg) < parent.start_seqno) {
amc ->         return false;
amc ->     }
amc ->     if (end_seqno_PresentQ(parent) && parent.end_seqno < seqno_Get(msg)) {
amc ->         return false;
amc ->     }
amc ->     // if field present in filter but not a member of ctype, return not filtered
amc ->     if (start_other_PresentQ(parent)) {
amc ->         return false;
amc ->     }
amc ->     // if field present in filter but not a member of ctype, return not filtered
amc ->     if (end_other_PresentQ(parent)) {
amc ->         return false;
amc ->     }
amc ->     // if field present in filter but not a member of ctype, return not filtered
amc ->     if (other_PresentQ(parent)) {
amc ->         return false;
amc ->     }
amc ->     return ret;
amc -> }
