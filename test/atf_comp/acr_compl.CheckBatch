# start acr_compl cmd:"$bindir/acr_compl -check_batch"
acr_compl <- acr_compl.checkreq  id:1  line:'acr ssimfile:%'
acr_compl <- acr_compl.checkreq  id:2  line:'nonexistent_tool -x'
acr_compl <- acr_compl.checkreq  id:3  line:'acr -nosuch_flag'
# eof acr_compl
acr_compl -> acr_compl.checkerr  id:2  err:'acr_compl.check  error:"unknown command"  value:nonexistent_tool'
acr_compl -> acr_compl.checkerr  id:3  err:'acr_compl.check  error:"unknown option"  value:nosuch_flag  command:acr'
# exit acr_compl code:1
