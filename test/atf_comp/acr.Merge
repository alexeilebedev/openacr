# start acr cmd:"$bindir/acr -merge ns:acr"
acr <- dmmeta.ns  ns:acr        nstype:lib         comment:"nstype attribute will be updated"
# eof acr
acr -> acr.update  dmmeta.ns  ns:acr  nstype:lib  license:GPL  comment:"nstype attribute will be updated"
acr -> report.acr  n_select:1  n_insert:0  n_delete:0  n_ignore:0  n_update:1  n_file_mod:0
# exit acr code:0
