# start mdbg cmd:"$bindir/mdbg -dry_run -tui mdbg mdbg -b a -b b -b c"
# eof mdbg
mdbg -> bin/abt  -target:mdbg -cfg:debug
mdbg -> #Gdb script is shown below
mdbg -> # This file was generated by mdbg
mdbg -> set history filename temp/gdb.history
mdbg -> set history save on
mdbg -> set debuginfod enabled off
mdbg -> set record instruction-history-size 1000000
mdbg -> set record function-call-history-size 100000
mdbg -> set record function-call-history 1000
mdbg -> set confirm off
mdbg -> handle all nostop noprint pass
mdbg -> handle SIGSEGV SIGBUS stop print nopass
mdbg -> set pagination off
mdbg -> catch throw
mdbg -> file build/debug/mdbg
mdbg -> set args mdbg
mdbg -> start
mdbg -> break a
mdbg -> break b
mdbg -> break c
mdbg -> break algo::FatalErrorExit
mdbg -> cont
mdbg -> # This file was generated by mdbg
mdbg -> gdb $gdbopt -tui --init-command=temp/mdbg.gdb
# exit mdbg code:0
