# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Name  comment:""
amc <- dmmeta.field  field:algo_lib.Name.ch  arg:char  reftype:Smallstr  dflt:""  comment:""
amc <- dmmeta.smallstr  field:algo_lib.Name.ch  length:20  strtype:rpascal  pad:""  strict:Y
amc <- dmmeta.cfmt  cfmt:algo_lib.Name.Json  printfmt:Auto  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Rec  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.value  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.name  arg:char  reftype:Smallstr  dflt:""  comment:""
amc <- dmmeta.smallstr  field:algo_lib.Rec.name  length:20  strtype:rpascal  pad:""  strict:Y
amc <- dmmeta.cfmt  cfmt:algo_lib.Rec.Json  printfmt:Auto  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Opaque  comment:""
amc <- dmmeta.field  field:algo_lib.Opaque.id  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RecVal  comment:""
amc <- dmmeta.field  field:algo_lib.RecVal.value  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.RecVal.opaque  arg:algo_lib.Opaque  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.RecVal.Json  printfmt:Auto  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RecAry  comment:""
amc <- dmmeta.field  field:algo_lib.RecAry.value  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.RecAry.opaque  arg:algo_lib.Opaque  reftype:Tary  dflt:""  comment:""
amc <- dmmeta.tary  field:algo_lib.RecAry.opaque  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.RecAry.Json  printfmt:Auto  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.InlOpaque  comment:""
amc <- dmmeta.field  field:algo_lib.InlOpaque.v  arg:algo_lib.Opaque  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.InlOpaque.Json  printfmt:Auto  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.InlAryOpaque  comment:""
amc <- dmmeta.field  field:algo_lib.InlAryOpaque.v  arg:algo_lib.Opaque  reftype:Tary  dflt:""  comment:""
amc <- dmmeta.tary  field:algo_lib.InlAryOpaque.v  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.InlAryOpaque.Json  printfmt:Auto  read:N  print:Y  sep:""  genop:Y  comment:""
# eof amc
amc -> amc.badjsonfld  cfmt:algo_lib.InlAryOpaque.Json  field:algo_lib.InlAryOpaque.v  reftype:Tary  comment:"element type has neither a Json cfmt nor a String print"
amc -> amc.badjsonfld  cfmt:algo_lib.InlOpaque.Json  field:algo_lib.InlOpaque.v  reftype:Val  comment:"field type has neither a Json cfmt nor a String print"
amc -> amc.badjsonfld  cfmt:algo_lib.Name.Json  field:algo_lib.Name.ch  reftype:Smallstr  comment:"unsupported reftype for JSON print"
amc -> amc.badjsonfld  cfmt:algo_lib.Rec.Json  field:algo_lib.Rec.name  reftype:Smallstr  comment:"unsupported reftype for JSON print"
amc -> amc.badjsonfld  cfmt:algo_lib.RecAry.Json  field:algo_lib.RecAry.opaque  reftype:Tary  comment:"element type has neither a Json cfmt nor a String print"
amc -> amc.badjsonfld  cfmt:algo_lib.RecVal.Json  field:algo_lib.RecVal.opaque  reftype:Val  comment:"field type has neither a Json cfmt nor a String print"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:6
