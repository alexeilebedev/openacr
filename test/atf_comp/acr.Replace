# start acr cmd:"$bindir/acr -replace ns:ns%"
acr <- dmmeta.ns  ns:ns1        nstype:exe      license:xx   comment:"This record will be replaced"
acr <- dmmeta.ns  ns:ns1        nstype:lib      license:yy   comment:"This record will remain"
# eof acr
acr -> acr.insert  dmmeta.ns  ns:ns1  nstype:lib  license:yy  comment:"This record will remain"
acr -> report.acr  n_select:1  n_insert:1  n_delete:0  n_ignore:0  n_update:0  n_file_mod:0
# exit acr code:0
