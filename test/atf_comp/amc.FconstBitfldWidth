# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- amcdb.bltin  ctype:i8  likeu64:Y  bigendok:N  issigned:Y  comment:"8-bit   signed integer"
amc <- amcdb.bltin  ctype:u8  likeu64:Y  bigendok:N  issigned:N  comment:"8-bit unsigned integer"
amc <- amcdb.bltin  ctype:i16  likeu64:Y  bigendok:Y  issigned:Y  comment:"16-bit   signed integer"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- amcdb.bltin  ctype:u16  likeu64:Y  bigendok:Y  issigned:N  comment:"16-bit unsigned integer"
amc <- amcdb.bltin  ctype:i32  likeu64:Y  bigendok:Y  issigned:Y  comment:"32-bit   signed integer"
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- amcdb.bltin  ctype:u32  likeu64:Y  bigendok:Y  issigned:N  comment:"32-bit unsigned integer"
amc <- amcdb.bltin  ctype:i64  likeu64:Y  bigendok:Y  issigned:Y  comment:"64-bit   signed integer"
amc <- amcdb.bltin  ctype:u64  likeu64:Y  bigendok:Y  issigned:N  comment:"64-bit unsigned integer"
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- amcdb.bltin  ctype:u128  likeu64:N  bigendok:Y  issigned:N  comment:"128-bit unsigned integer"
amc <- amcdb.bltin  ctype:bool  likeu64:Y  bigendok:N  issigned:N  comment:"dflt is a c++ expr: real dflt is 'N'"
amc <- dmmeta.ctype  ctype:pad_byte  comment:""
amc <- dmmeta.csize  ctype:pad_byte  size:1  alignment:1  comment:""
amc <- dmmeta.cfmt  cfmt:pad_byte.String  printfmt:Extern  read:Y  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.pack  ctype:pad_byte  comment:""
amc <- amcdb.bltin  ctype:char  likeu64:Y  bigendok:N  issigned:N  comment:char
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Rec  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.word  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.dword  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.dword2  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.oword  arg:u128  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.negw  arg:u32  reftype:Bitfld  dflt:""  comment:"width below the range: names no bits"
amc <- dmmeta.bitfld  field:algo_lib.Rec.negw  offset:0  width:-64  srcfield:algo_lib.Rec.word  comment:""
amc <- dmmeta.fconst  fconst:algo_lib.Rec.negw/one  value:1  comment:"a bad width bounds nothing, so the value draws no range complaint"
amc <- dmmeta.field  field:algo_lib.Rec.zerow  arg:u32  reftype:Bitfld  dflt:""  comment:"width below the range: names no bits"
amc <- dmmeta.bitfld  field:algo_lib.Rec.zerow  offset:1  width:0  srcfield:algo_lib.Rec.word  comment:""
amc <- dmmeta.fconst  fconst:algo_lib.Rec.zerow/one  value:1  comment:"a bad width bounds nothing, so the value draws no range complaint"
amc <- dmmeta.field  field:algo_lib.Rec.widew  arg:u128  reftype:Bitfld  dflt:""  comment:"width above the range: more bits than a u64 mask holds"
amc <- dmmeta.bitfld  field:algo_lib.Rec.widew  offset:0  width:65  srcfield:algo_lib.Rec.oword  comment:""
amc <- dmmeta.fconst  fconst:algo_lib.Rec.widew/one  value:1  comment:"a bad width bounds nothing, so the value draws no range complaint"
amc <- dmmeta.field  field:algo_lib.Rec.w1  arg:u32  reftype:Bitfld  dflt:""  comment:"the narrowest width the range admits"
amc <- dmmeta.bitfld  field:algo_lib.Rec.w1  offset:2  width:1  srcfield:algo_lib.Rec.word  comment:""
amc <- dmmeta.fconst  fconst:algo_lib.Rec.w1/maxstore  value:1  comment:"the widest value one bit holds"
amc <- dmmeta.fconst  fconst:algo_lib.Rec.w1/past  value:2  comment:"past one bit, would be stored masked"
amc <- dmmeta.field  field:algo_lib.Rec.w10  arg:u32  reftype:Bitfld  dflt:""  comment:"bits hold less than the arg type"
amc <- dmmeta.bitfld  field:algo_lib.Rec.w10  offset:3  width:10  srcfield:algo_lib.Rec.word  comment:""
amc <- dmmeta.fconst  fconst:algo_lib.Rec.w10/maxstore  value:1023  comment:"the widest value ten bits hold"
amc <- dmmeta.fconst  fconst:algo_lib.Rec.w10/past  value:2000  comment:"past ten bits, would be stored masked"
amc <- dmmeta.field  field:algo_lib.Rec.w63  arg:u64  reftype:Bitfld  dflt:""  comment:"the widest width the mask shift builds"
amc <- dmmeta.bitfld  field:algo_lib.Rec.w63  offset:0  width:63  srcfield:algo_lib.Rec.dword  comment:""
amc <- dmmeta.fconst  fconst:algo_lib.Rec.w63/maxstore  value:0x7fffffffffffffff  comment:"the widest value sixty-three bits hold"
amc <- dmmeta.fconst  fconst:algo_lib.Rec.w63/past  value:0x8000000000000000  comment:"past sixty-three bits, would be stored masked"
amc <- dmmeta.field  field:algo_lib.Rec.w64  arg:u64  reftype:Bitfld  dflt:""  comment:"width spans the whole arg type"
amc <- dmmeta.bitfld  field:algo_lib.Rec.w64  offset:0  width:64  srcfield:algo_lib.Rec.dword2  comment:""
amc <- dmmeta.fconst  fconst:algo_lib.Rec.w64/argmax  value:0xffffffffffffffff  comment:"the arg type's maximum, which sixty-four bits hold"
# eof amc
amc -> amc.bitfield_bounds  bitfld:algo_lib.Rec.negw  offset:0  width:-64  comment:"bitfield offset must be 0..127 and width must be 1..64"
amc -> amc.bitfield_bounds  bitfld:algo_lib.Rec.zerow  offset:1  width:0  comment:"bitfield offset must be 0..127 and width must be 1..64"
amc -> amc.bitfield_bounds  bitfld:algo_lib.Rec.widew  offset:0  width:65  comment:"bitfield offset must be 0..127 and width must be 1..64"
amc -> amc.fconst_range  fconst:algo_lib.Rec.w1/past  value:2  min:0  max:1  comment:"fconst value does not fit the field's store and would be stored masked"
amc -> amc.fconst_range  fconst:algo_lib.Rec.w10/past  value:2000  min:0  max:1023  comment:"fconst value does not fit the field's store and would be stored masked"
amc -> amc.fconst_range  fconst:algo_lib.Rec.w63/past  value:0x8000000000000000  min:0  max:9223372036854775807  comment:"fconst value does not fit the field's store and would be stored masked"
amc -> amc.error  amc.bitfield_width  field:algo_lib.Rec.negw  comment:'bitfield width must be 1..64 bits'
# exit amc code:1
