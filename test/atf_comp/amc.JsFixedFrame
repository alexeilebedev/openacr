bash -> export function MsgFix_Encode(view: DataView, offset: number, parent: MsgFix) {
bash ->     let length = 8;
bash ->     view.setUint32(offset+0,length,true);
bash ->     view.setUint32(offset+4,parent.val,true);
bash ->     return length;
bash -> }
bash -> export function MsgVar_Encode(view: DataView, offset: number, parent: MsgVar) {
bash ->     let length = 4;
bash ->     if (parent.data.length > view.byteLength - (offset + length)) {
bash ->         throw new RangeError("MsgVar_Encode: data does not fit in the target buffer");
bash ->     }
bash ->     new Uint8Array(view.buffer,view.byteOffset+offset+length,view.byteLength-(offset+length)).set(parent.data);
bash ->     length += parent.data.length;
bash ->     if (length > 2147483647) {
bash ->         throw new RangeError("MsgVar_Encode: frame length " + length + " exceeds the frame length range (max 2147483647)");
bash ->     }
bash ->     view.setUint32(offset+0,length,true);
bash ->     return length;
bash -> }
