# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ccmp  ctype:u32  extrn:N  genop:N  order:N  minmax:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.TestMinmax  comment:""
amc <- dmmeta.field  field:algo_lib.TestMinmax.value  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ccmp  ctype:algo_lib.TestMinmax  extrn:N  genop:N  order:N  minmax:Y  comment:""
# eof amc
amc -> amc.ccmp_minmax  ccmp:algo_lib.TestMinmax  extrn:N  genop:N  order:N  comment:"minmax:Y requires an operator < : a builtin type, extrn:Y, or genop:Y order:Y"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:1
