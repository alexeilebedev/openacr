amc <- dmmeta.fcond  fcond:algo_lib.FConn.in/ready  ins:algo_lib.FDb.cd_conn_read  via:""  rem:Y  comment:"accepted control: an Llist of the watched ctype"
amc <- dmmeta.fcond  fcond:algo_lib.FConn.in_hash/ready  ins:algo_lib.FDb.ind_conn  via:""  rem:Y  comment:"rejected: a hash offers InsertMaybe, not Insert"
# eof amc
amc -> amc.error  amc.fcond_ins  fcond:algo_lib.FConn.in_hash/ready  reftype:Thash  comment:"ins must name an Llist or Bheap"
# exit amc code:1
