amc -> // --- algo_lib.RecName..FmtJson
amc -> // Create JSON representation of algo_lib::RecName under PARENT node
amc -> // cfmt:algo_lib.RecName.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::RecName_FmtJson(algo_lib::RecName& row, lib_json::FNode *parent) {
amc ->     lib_json::FNode *objnode = &lib_json::node_Alloc();
amc ->     objnode->p_parent = parent?parent:objnode;
amc ->     objnode->type   = lib_json_FNode_type_object;
amc ->     node_XrefMaybe(*objnode);
amc ->     algo::aryptr<u32> object_ary = object_Getary(row);
amc ->     lib_json::FNode& object_node = lib_json::NewArrayNode(objnode, "object");
amc ->     for (int i = 0; i < object_ary.n_elems; ++i) {
amc ->         u32_Print(object_ary[i], lib_json::NewStringNode(&object_node).value);
amc ->     }
amc ->     algo::aryptr<u32> objnode_ary = objnode_Getary(row);
amc ->     lib_json::FNode& objnode_node = lib_json::NewArrayNode(objnode, "objnode");
amc ->     for (int i = 0; i < objnode_ary.n_elems; ++i) {
amc ->         u32_Print(objnode_ary[i], lib_json::NewStringNode(&objnode_node).value);
amc ->     }
amc ->     lib_json::FNode *x_node = &lib_json::node_Alloc();
amc ->     x_node->p_parent = objnode;
amc ->     x_node->type   = lib_json_FNode_type_field;
amc ->     x_node->value  = "x";
amc ->     node_XrefMaybe(*x_node);
amc ->     algo_lib::Elem_FmtJson(row.x,x_node);
amc ->     algo::aryptr<u32> x_field_ary = x_field_Getary(row);
amc ->     lib_json::FNode& x_field_node = lib_json::NewArrayNode(objnode, "x_field");
amc ->     for (int i = 0; i < x_field_ary.n_elems; ++i) {
amc ->         u32_Print(x_field_ary[i], lib_json::NewStringNode(&x_field_node).value);
amc ->     }
amc ->     algo::aryptr<u32> y_ary = y_Getary(row);
amc ->     lib_json::FNode& y_node = lib_json::NewArrayNode(objnode, "y");
amc ->     for (int i = 0; i < y_ary.n_elems; ++i) {
amc ->         u32_Print(y_ary[i], lib_json::NewStringNode(&y_node).value);
amc ->     }
amc ->     algo::aryptr<u32> y_ary_ary = y_ary_Getary(row);
amc ->     lib_json::FNode& y_ary_node = lib_json::NewArrayNode(objnode, "y_ary");
amc ->     for (int i = 0; i < y_ary_ary.n_elems; ++i) {
amc ->         u32_Print(y_ary_ary[i], lib_json::NewStringNode(&y_ary_node).value);
amc ->     }
amc ->     return objnode;
amc -> }
amc -> // --- algo_lib.ValElem..FmtJson
amc -> // Create JSON representation of algo_lib::ValElem under PARENT node
amc -> // cfmt:algo_lib.ValElem.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::ValElem_FmtJson(algo_lib::ValElem row, lib_json::FNode *parent) {
