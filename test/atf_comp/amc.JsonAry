amc -> // --- algo_lib.Elem..FmtJson
amc -> // Create JSON representation of algo_lib::Elem under PARENT node
amc -> // cfmt:algo_lib.Elem.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::Elem_FmtJson(algo_lib::Elem row, lib_json::FNode *parent) {
amc ->     lib_json::FNode *objnode = &lib_json::node_Alloc();
amc ->     objnode->p_parent = parent?parent:objnode;
amc ->     objnode->type   = lib_json_FNode_type_object;
amc ->     node_XrefMaybe(*objnode);
amc ->     u32_Print(row.n, lib_json::NewStringNode(objnode, "n").value);
amc ->     u32_Print(row.m, lib_json::NewStringNode(objnode, "m").value);
amc ->     return objnode;
amc -> }
amc -> // --- algo_lib.AryElem..FmtJson
amc -> // Create JSON representation of algo_lib::AryElem under PARENT node
amc -> // cfmt:algo_lib.AryElem.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::AryElem_FmtJson(algo_lib::AryElem& row, lib_json::FNode *parent) {
amc ->     algo::aryptr<algo_lib::Elem> rec_ary = rec_Getary(row);
amc ->     lib_json::FNode& rec_node = lib_json::NewArrayNode(parent);
amc ->     for (int i = 0; i < rec_ary.n_elems; ++i) {
amc ->         algo_lib::Elem_FmtJson(rec_ary[i], &rec_node);
amc ->     }
amc ->     return &rec_node;
amc -> }
amc -> // --- algo_lib.AryPlain..FmtJson
amc -> // Create JSON representation of algo_lib::AryPlain under PARENT node
amc -> // cfmt:algo_lib.AryPlain.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::AryPlain_FmtJson(algo_lib::AryPlain& row, lib_json::FNode *parent) {
amc ->     algo::aryptr<u32> buf_ary = buf_Getary(row);
amc ->     lib_json::FNode& buf_node = lib_json::NewArrayNode(parent);
amc ->     for (int i = 0; i < buf_ary.n_elems; ++i) {
amc ->         u32_Print(buf_ary[i], lib_json::NewStringNode(&buf_node).value);
amc ->     }
amc ->     return &buf_node;
amc -> }
amc -> // --- algo_lib.Rec..FmtJson
amc -> // Create JSON representation of algo_lib::Rec under PARENT node
amc -> // cfmt:algo_lib.Rec.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::Rec_FmtJson(algo_lib::Rec& row, lib_json::FNode *parent) {
amc ->     lib_json::FNode *objnode = &lib_json::node_Alloc();
amc ->     objnode->p_parent = parent?parent:objnode;
amc ->     objnode->type   = lib_json_FNode_type_object;
amc ->     node_XrefMaybe(*objnode);
amc ->     u32_Print(row.n, lib_json::NewStringNode(objnode, "n").value);
amc ->     algo::aryptr<u32> buf_ary = buf_Getary(row);
amc ->     lib_json::FNode& buf_node = lib_json::NewArrayNode(objnode, "buf");
amc ->     for (int i = 0; i < buf_ary.n_elems; ++i) {
amc ->         u32_Print(buf_ary[i], lib_json::NewStringNode(&buf_node).value);
amc ->     }
amc ->     algo::aryptr<algo_lib::Elem> rec_ary = rec_Getary(row);
amc ->     lib_json::FNode& rec_node = lib_json::NewArrayNode(objnode, "rec");
amc ->     for (int i = 0; i < rec_ary.n_elems; ++i) {
amc ->         algo_lib::Elem_FmtJson(rec_ary[i], &rec_node);
