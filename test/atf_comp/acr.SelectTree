# start acr cmd:"$bindir/acr -in:- ctype:command.acr -t"
acr <- dev.license  license:GPL  comment:""
acr <- dmmeta.nstype  nstype:protocol  comment:"Protocol (not a target)"
acr <- dmmeta.ns  ns:command  nstype:protocol  license:GPL  comment:"Command line descriptions"
acr <- dmmeta.ctype  ctype:command.acr  comment:""
acr <- dmmeta.field  field:command.acr.query  arg:algo.cstring  reftype:Val  dflt:'""'  comment:"Regx to match record"
acr <- dmmeta.anonfld  field:command.acr.query  comment:""
acr <- dmmeta.field  field:command.acr.schema    arg:algo.cstring  reftype:Val  dflt:'"data"'  comment:"Directory for initializing acr meta-data"
acr <- dmmeta.floadtuples  field:command.acr.schema    comment:""
acr <- dmmeta.ctypelen  ctype:command.acr  len:192  alignment:8  padbytes:21
acr <- dmmeta.field  field:acr.FDb.cmdline  arg:command.acr  reftype:Val  dflt:""  comment:"command line"
acr <- dmmeta.fcmdline  field:acr.FDb.cmdline  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
# eof acr
acr -> dev.license  license:GPL  comment:""
acr -> dmmeta.nstype  nstype:protocol  comment:"Protocol (not a target)"
acr ->   dmmeta.ns  ns:command  nstype:protocol  license:GPL  comment:"Command line descriptions"
acr ->     dmmeta.ctype  ctype:command.acr  comment:""
acr ->       dmmeta.field  field:command.acr.query  arg:algo.cstring  reftype:Val  dflt:'""'  comment:"Regx to match record"
acr ->         dmmeta.anonfld  field:command.acr.query  comment:""
acr ->       dmmeta.field  field:command.acr.schema  arg:algo.cstring  reftype:Val  dflt:'"data"'  comment:"Directory for initializing acr meta-data"
acr ->         dmmeta.floadtuples  field:command.acr.schema  comment:""
acr ->       dmmeta.ctypelen  ctype:command.acr  len:192  alignment:8  padbytes:21  plaindata:N
acr -> dmmeta.field  field:acr.FDb.cmdline  arg:command.acr  reftype:Val  dflt:""  comment:"command line"
acr ->   dmmeta.fcmdline  field:acr.FDb.cmdline  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
acr -> report.acr  n_select:11  n_insert:0  n_delete:0  n_ignore:0  n_update:0  n_file_mod:0
# exit acr code:0
