# start acr cmd:"$bindir/acr ftuple -meta"
# eof acr
acr -> dmmeta.ctype  ctype:dmmeta.Ftuple  comment:""
acr ->   dmmeta.field  field:dmmeta.Ftuple.field    arg:dmmeta.Field  reftype:Pkey  dflt:""  comment:""
acr ->   dmmeta.field  field:dmmeta.Ftuple.comment  arg:algo.Comment  reftype:Val   dflt:""  comment:""
acr ->   dmmeta.cfmt  cfmt:dmmeta.Ftuple.String  printfmt:Tuple  read:Y  print:Y  sep:""  genop:Y  comment:""
acr ->   dmmeta.ctypelen  ctype:dmmeta.Ftuple  len:254  alignment:1  padbytes:0  plaindata:Y
acr -> report.acr  n_select:5  n_insert:0  n_delete:0  n_ignore:0  n_update:0  n_file_mod:0
# exit acr code:0
