# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CycA  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CycB  comment:""
amc <- dmmeta.field  field:algo_lib.CycA.b  arg:algo_lib.CycB  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.CycB.a  arg:algo_lib.CycA  reftype:Val  dflt:""  comment:""
amc <- dmmeta.fdec  field:algo_lib.CycA.b  nplace:2  fixedfmt:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CycSelf  comment:""
amc <- dmmeta.field  field:algo_lib.CycSelf.self  arg:algo_lib.CycSelf  reftype:Val  dflt:""  comment:""
amc <- dmmeta.fdec  field:algo_lib.CycSelf.self  nplace:2  fixedfmt:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CycBit  comment:""
amc <- dmmeta.field  field:algo_lib.CycBit.word  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.CycBit.slice  arg:algo_lib.CycSelf  reftype:Bitfld  dflt:""  comment:""
amc <- dmmeta.bitfld  field:algo_lib.CycBit.slice  offset:0  width:4  srcfield:algo_lib.CycBit.word  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CycBitSrc  comment:""
amc <- dmmeta.field  field:algo_lib.CycBitSrc.word  arg:algo_lib.CycSelf  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.CycBitSrc.slice  arg:u32  reftype:Bitfld  dflt:""  comment:""
amc <- dmmeta.bitfld  field:algo_lib.CycBitSrc.slice  offset:0  width:4  srcfield:algo_lib.CycBitSrc.word  comment:""
# eof amc
amc -> amc.bad_numtype  field:algo_lib.CycA.b  arg:algo_lib.CycB  comment:"fdec arg must resolve to an integer builtin"
amc -> amc.bad_numtype  field:algo_lib.CycSelf.self  arg:algo_lib.CycSelf  comment:"fdec arg must resolve to an integer builtin"
amc -> amc.size_cycle  ctype:algo_lib.CycB  comment:"ctype contains itself by value; size cannot be computed"
amc -> amc.size_unknown_recursive  ctype:algo_lib.CycA  field:b  fieldtype:algo_lib.CycB  field_is_extern:N  comment:"size of field unknown, recursively propagated to the type"
amc -> amc.size_unknown_recursive  ctype:algo_lib.CycB  field:a  fieldtype:algo_lib.CycA  field_is_extern:N  comment:"size of field unknown, recursively propagated to the type"
amc -> amc.size_cycle  ctype:algo_lib.CycSelf  comment:"ctype contains itself by value; size cannot be computed"
amc -> amc.size_unknown_recursive  ctype:algo_lib.CycSelf  field:self  fieldtype:algo_lib.CycSelf  field_is_extern:N  comment:"size of field unknown, recursively propagated to the type"
amc -> amc.size_unknown_recursive  ctype:algo_lib.CycBitSrc  field:word  fieldtype:algo_lib.CycSelf  field_is_extern:N  comment:"size of field unknown, recursively propagated to the type"
amc -> amc.error  circular type definition in algo_lib.CycA
# exit amc code:1
