# start amc cmd:"$bindir/amc -in_dir:test/amc/bad_inlary_min.ssim -out_dir: -report:N zzz"
# eof amc
amc -> amc.bad_inlary_min  inlary:algo_lib.TestInlaryMin.str  elem_type:char  comment:"a variable char/u8 inlary is read by copying the string, which cannot keep a minimum count; use min:0 or a fixed inlary"
amc -> amc.bad_inlary_min  inlary:algo_lib.TestInlaryMin.buf  elem_type:u8  comment:"a variable char/u8 inlary is read by copying the string, which cannot keep a minimum count; use min:0 or a fixed inlary"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:2
