# start sandbox cmd:"$bindir/sandbox amc -diff -dry_run -q"
# eof sandbox
sandbox -> dry_run: set -eu -o pipefail
sandbox -> curdir=$(pwd)
sandbox -> ref_sha=$(git rev-parse HEAD)
sandbox -> extra_sha=$(git rev-parse HEAD | tr '\n' ' ')
sandbox -> gitfiles="$(git ls-files -m) .gcache .gitignore build temp/.empty"
sandbox -> clone_sandbox() {
sandbox ->   local dir=$1
sandbox ->   if git rev-parse --is-shallow-repository | grep -q true; then
sandbox ->     git clone . "$dir" 2>/dev/null
sandbox ->   else  # ignore:hanging_else
sandbox ->     git clone --local . "$dir" 2>/dev/null
sandbox ->   fi
sandbox -> }
sandbox -> sync_sandbox() {
sandbox ->   local dir=$1
sandbox ->   git -C "$dir" fetch -q "$curdir" "$ref_sha" $extra_sha
sandbox ->   git -C "$dir" reset --hard -q
sandbox ->   git -C "$dir" clean --exclude=build --exclude=.gcache -fxq .
sandbox ->   git -C "$dir" checkout -B baseline "$ref_sha" -q
sandbox -> }
sandbox -> reset_sandbox() {
sandbox ->   local dir=$1 name=$2 quiet=${3:-}
sandbox ->   [ -z "$quiet" ] && echo "sandbox.reset  sandbox:$name  dir:$dir" >&2
sandbox ->   [ ! -d "$dir" ] && clone_sandbox "$dir"
sandbox ->   if ! sync_sandbox "$dir"; then
sandbox ->     rm -rf "$dir"
sandbox ->     clone_sandbox "$dir"
sandbox ->   fi
sandbox ->   rsync --relative --ignore-missing-args -ac $gitfiles "$dir/"
sandbox ->   git -C "$dir" commit --allow-empty -m baseline -q 2>/dev/null
sandbox -> }
sandbox -> [ ! -d "temp/sandbox.amc" ] && reset_sandbox "temp/sandbox.amc" "amc" "1"
sandbox -> pushd "temp/sandbox.amc" >/dev/null || exit 1
sandbox -> git diff
sandbox -> popd >/dev/null || exit 1
# exit sandbox code:0
