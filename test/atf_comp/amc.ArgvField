amc -> // --- algo_lib.Cmd..PrintArgv
amc -> // print string representation of ROW to string STR
amc -> // cfmt:algo_lib.Cmd.Argv  printfmt:Auto
amc -> void algo_lib::Cmd_PrintArgv(algo_lib::Cmd& row, algo::cstring& str) {
amc ->     algo::tempstr temp;
amc ->     (void)temp;
amc ->     (void)str;
amc ->     ch_RemoveAll(temp);
amc ->     u64_Print(row.count, temp);
amc ->     str << " -count:";
amc ->     strptr_PrintBash(temp,str);
amc ->     if (!(row.plain == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(row.plain, temp);
amc ->         str << " -plain:";
amc ->         strptr_PrintBash(temp,str);
amc ->     }
amc ->     if (!(row.state == 0)) {
amc ->         ch_RemoveAll(temp);
amc ->         algo_lib::state_Print(row, temp);
amc ->         str << " -state:";
amc ->         strptr_PrintBash(temp,str);
amc ->     }
amc ->     if (!(big_Get(row) == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(big_Get(row), temp);
amc ->         str << " -big:";
amc ->         strptr_PrintBash(temp,str);
amc ->     }
amc ->     if (!(row.word == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(row.word, temp);
amc ->         str << " -word:";
amc ->         strptr_PrintBash(temp,str);
amc ->     }
amc ->     if (!(row.limit == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(row.limit, temp);
amc ->         str << " -limit:";
amc ->         strptr_PrintBash(temp,str);
amc ->     }
amc ->     if (!(row.mode == 0)) {
amc ->         ch_RemoveAll(temp);
amc ->         algo_lib::mode_Print(row, temp);
amc ->         str << " -mode:";
amc ->         strptr_PrintBash(temp,str);
amc ->     }
amc ->     ch_RemoveAll(temp);
amc ->     algo_lib::name_Print(row, temp);
amc ->     str << " -name:";
amc ->     strptr_PrintBash(temp,str);
amc ->     ind_beg(Cmd_tag_curs,value,row) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(value, temp);
amc ->         str << " -tag:";
amc ->         strptr_PrintBash(temp,str);
amc ->     }ind_end;
amc -> }
amc -> // --- algo_lib.Cmd..ToArgv
amc -> // Build argv from ROW into ARGS; args[0] is the command name
amc -> // cfmt:algo_lib.Cmd.Argv  printfmt:Auto
amc -> void algo_lib::Cmd_ToArgv(algo_lib::Cmd& row, algo::StringAry& args) {
amc ->     algo::tempstr temp;
amc ->     (void)temp;
amc ->     ary_RemoveAll(args);
amc ->     ary_Alloc(args) << "bin/Cmd"; // command path
amc ->     ch_RemoveAll(temp);
amc ->     u64_Print(row.count, temp);
amc ->     ary_Alloc(args) << "-count:" << temp;
amc ->     if (!(row.plain == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(row.plain, temp);
amc ->         ary_Alloc(args) << "-plain:" << temp;
amc ->     }
amc ->     if (!(row.state == 0)) {
amc ->         ch_RemoveAll(temp);
amc ->         algo_lib::state_Print(row, temp);
amc ->         ary_Alloc(args) << "-state:" << temp;
amc ->     }
amc ->     if (!(big_Get(row) == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(big_Get(row), temp);
amc ->         ary_Alloc(args) << "-big:" << temp;
amc ->     }
amc ->     if (!(row.word == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(row.word, temp);
amc ->         ary_Alloc(args) << "-word:" << temp;
amc ->     }
amc ->     if (!(row.limit == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(row.limit, temp);
amc ->         ary_Alloc(args) << "-limit:" << temp;
amc ->     }
amc ->     if (!(row.mode == 0)) {
amc ->         ch_RemoveAll(temp);
amc ->         algo_lib::mode_Print(row, temp);
amc ->         ary_Alloc(args) << "-mode:" << temp;
amc ->     }
amc ->     ch_RemoveAll(temp);
amc ->     algo_lib::name_Print(row, temp);
amc ->     ary_Alloc(args) << "-name:" << temp;
amc ->     ind_beg(Cmd_tag_curs,value,row) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(value, temp);
amc ->         ary_Alloc(args) << "-tag:" << temp;
amc ->     }ind_end;
amc -> }
amc -> // --- algo_lib.FDb..PrintArgv
amc -> // print string representation of ROW to string STR
amc -> // cfmt:algo_lib.FDb.Argv  printfmt:Auto
amc -> void algo_lib::FDb_PrintArgv(algo_lib::FDb& row, algo::cstring& str) {
amc ->     algo::tempstr temp;
amc ->     (void)temp;
amc ->     (void)str;
amc ->     ch_RemoveAll(temp);
amc ->     u64_Print(row.malloc, temp);
amc ->     str << " -malloc:";
amc ->     strptr_PrintBash(temp,str);
amc ->     ch_RemoveAll(temp);
amc ->     trace_Print(row.trace, temp);
amc ->     str << " -trace:";
amc ->     strptr_PrintBash(temp,str);
amc -> }
amc -> // --- algo_lib.Flags..PrintArgv
amc -> // print string representation of ROW to string STR
amc -> // cfmt:algo_lib.Flags.Argv  printfmt:Auto
amc -> void algo_lib::Flags_PrintArgv(algo_lib::Flags row, algo::cstring& str) {
amc ->     algo::tempstr temp;
amc ->     (void)temp;
amc ->     (void)str;
amc ->     if (!(seqno_Get(row) == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(seqno_Get(row), temp);
amc ->         str << " -seqno:";
amc ->         strptr_PrintBash(temp,str);
amc ->     }
amc ->     ch_RemoveAll(temp);
amc ->     bool_Print(flag_Get(row), temp);
amc ->     str << " -flag:";
amc ->     strptr_PrintBash(temp,str);
amc -> }
amc -> // --- algo_lib.Flags..ToArgv
amc -> // Build argv from ROW into ARGS; args[0] is the command name
amc -> // cfmt:algo_lib.Flags.Argv  printfmt:Auto
amc -> void algo_lib::Flags_ToArgv(algo_lib::Flags row, algo::StringAry& args) {
amc ->     algo::tempstr temp;
amc ->     (void)temp;
amc ->     ary_RemoveAll(args);
amc ->     ary_Alloc(args) << "bin/Flags"; // command path
amc ->     if (!(seqno_Get(row) == u32())) {
amc ->         ch_RemoveAll(temp);
amc ->         u32_Print(seqno_Get(row), temp);
amc ->         ary_Alloc(args) << "-seqno:" << temp;
amc ->     }
amc ->     ch_RemoveAll(temp);
amc ->     bool_Print(flag_Get(row), temp);
amc ->     ary_Alloc(args) << "-flag:" << temp;
amc -> }
# exit amc code:0
