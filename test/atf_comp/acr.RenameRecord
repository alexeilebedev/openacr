# start acr cmd:"$bindir/acr -in:- target:samp -rename:xyz"
acr <- dmmeta.ns  ns:samp  nstype:exe  license:GPL  comment:""
acr <- dev.target  target:samp  compat:%-%g%.%-%
acr <- dev.targdep  targdep:samp.algo_lib  comment:""
acr <- dev.targsrc  targsrc:samp/cpp/samp/1.cpp          comment:""
acr <- dev.targsrc  targsrc:samp/cpp/samp/2.cpp      comment:""
# eof acr
acr -> acr.delete  dev.target  target:samp
acr -> acr.insert  dev.target  target:xyz
acr -> acr.delete  dev.targdep  targdep:samp.algo_lib
acr -> acr.insert  dev.targdep  targdep:xyz.algo_lib  comment:""
acr -> acr.delete  dev.targsrc  targsrc:samp/cpp/samp/1.cpp
acr -> acr.insert  dev.targsrc  targsrc:xyz/cpp/samp/1.cpp  comment:""
acr -> acr.delete  dev.targsrc  targsrc:samp/cpp/samp/2.cpp
acr -> acr.insert  dev.targsrc  targsrc:xyz/cpp/samp/2.cpp  comment:""
acr -> report.acr  n_select:4  n_insert:0  n_delete:0  n_ignore:0  n_update:4  n_file_mod:0  n_badline:0
# exit acr code:0
