# start acr_ed cmd:"$bindir/acr_ed -create -target xyz"
# eof acr_ed
acr_ed -> acr_ed.create_target  target:xyz
acr_ed -> set -e
acr_ed -> bin/acr  -query:'' -replace:Y -check:Y -selerr:N -write:Y -t:Y << EOF
acr_ed -> dmmeta.ns  ns:xyz  nstype:exe  license:GPL  comment:""
acr_ed -> dmmeta.nsx  ns:xyz  genthrow:Y  correct_getorcreate:Y  pool:algo_lib.FDb.malloc  sortxref:Y  pack:N  comment:""
acr_ed -> dmmeta.main  ns:xyz  ismodule:N
acr_ed -> dmmeta.nscpp  ns:xyz  comment:""
acr_ed -> dev.target  target:xyz
acr_ed -> dev.gitfile  gitfile:cpp/xyz/xyz.cpp
acr_ed -> dev.gitfile  gitfile:include/xyz.h
acr_ed -> dev.gitfile  gitfile:cpp/gen/xyz_gen.cpp
acr_ed -> dev.gitfile  gitfile:include/gen/xyz_gen.h
acr_ed -> dev.gitfile  gitfile:include/gen/xyz_gen.inl.h
acr_ed -> dev.gitfile  gitfile:bin/xyz  comment:''
acr_ed -> dev.targsrc  targsrc:xyz/cpp/xyz/xyz.cpp  comment:''
acr_ed -> dev.targsrc  targsrc:xyz/include/xyz.h  comment:''
acr_ed -> dev.targsrc  targsrc:xyz/cpp/gen/xyz_gen.cpp  comment:''
acr_ed -> dev.targsrc  targsrc:xyz/include/gen/xyz_gen.h  comment:''
acr_ed -> dev.targsrc  targsrc:xyz/include/gen/xyz_gen.inl.h  comment:''
acr_ed -> dev.targdep  targdep:xyz.algo_lib  comment:''
acr_ed -> dev.targdep  targdep:xyz.lib_prot  comment:''
acr_ed -> dmmeta.ctype  ctype:xyz.FDb  comment:''
acr_ed -> dmmeta.field  field:xyz.FDb._db  arg:xyz.FDb  reftype:Global  dflt:''  comment:''  
acr_ed -> dmmeta.ctype  ctype:command.xyz  comment:""
acr_ed -> dmmeta.cfmt  cfmt:command.xyz.Argv  printfmt:Tuple  read:Y  print:Y  sep:""  genop:Y  comment:""
acr_ed -> dmmeta.field  field:xyz.FDb.cmdline  arg:command.xyz  reftype:Val  dflt:""  comment:""
acr_ed -> dmmeta.ccmdline  ctype:command.xyz  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
acr_ed -> dmmeta.field  field:command.xyz.in  arg:algo.cstring  reftype:Val  dflt:'"data"'  comment:"Input directory or filename, - for stdin"
acr_ed -> dmmeta.floadtuples  field:command.xyz.in  autoscan:Y  optional:N  comment:""
acr_ed -> dev.gitfile  gitfile:txt/exe/xyz/README.md
acr_ed -> dev.readmefile  gitfile:txt/exe/xyz/README.md  inl:N  sandbox:N  filter:""  comment:""
acr_ed -> dev.gitfile  gitfile:txt/gen/xyz/xyz.md
acr_ed -> dev.readmefile  gitfile:txt/gen/xyz/xyz.md  inl:N  sandbox:N  filter:""  comment:""
acr_ed -> EOF
acr_ed -> mkdir -p cpp/xyz/
acr_ed -> touch cpp/xyz/xyz.cpp
acr_ed -> git add cpp/xyz/xyz.cpp
acr_ed -> mkdir -p include/
acr_ed -> touch include/xyz.h
acr_ed -> git add include/xyz.h
acr_ed -> mkdir -p cpp/gen/
acr_ed -> touch cpp/gen/xyz_gen.cpp
acr_ed -> git add cpp/gen/xyz_gen.cpp
acr_ed -> mkdir -p include/gen/
acr_ed -> touch include/gen/xyz_gen.h
acr_ed -> git add include/gen/xyz_gen.h
acr_ed -> mkdir -p include/gen/
acr_ed -> touch include/gen/xyz_gen.inl.h
acr_ed -> git add include/gen/xyz_gen.inl.h
acr_ed -> mkdir -p cpp/xyz/
acr_ed -> cat > include/xyz.h << EOF
acr_ed -> #include "include/gen/xyz_gen.h"
acr_ed -> #include "include/gen/xyz_gen.inl.h"
acr_ed -> namespace xyz { // update-hdr
acr_ed -> }
acr_ed -> EOF
acr_ed -> cat > cpp/xyz/xyz.cpp << EOF
acr_ed -> #include "include/algo.h"
acr_ed -> #include "include/algo.h"
acr_ed -> #include "include/xyz.h"
acr_ed -> void xyz::Main() {
acr_ed ->     prlog("Hello, World!");
acr_ed ->     xyz::MainLoop();
acr_ed -> }
acr_ed -> EOF
acr_ed -> bin/amc  # make sure */gen/* files are created
acr_ed -> ln -s ../build/release/xyz bin/xyz
acr_ed -> git add -f bin/xyz
acr_ed -> mkdir -p txt/exe/xyz/
acr_ed -> touch txt/exe/xyz/README.md
acr_ed -> git add txt/exe/xyz/README.md
acr_ed -> mkdir -p txt/gen/xyz/
acr_ed -> touch txt/gen/xyz/xyz.md
acr_ed -> git add txt/gen/xyz/xyz.md
acr_ed -> bin/src_hdr  -targsrc:xyz/% -write:Y -update_copyright:Y
acr_ed -> bin/abt  -target:xyz -install:Y
acr_ed -> echo 'please execute $(acr_compl -install) to add completions support for new target'
acr_ed -> bin/abt_md  -readmefile:% -ns:xyz -section:%
acr_ed -> bin/amc
# exit acr_ed code:0
