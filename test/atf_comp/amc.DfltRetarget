# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N '(algo_lib.Rec..Init|algo_lib.Msg..Init|algo_lib.Ptr..Init)' < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Rec  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.val  arg:u32  reftype:Val  dflt:"*thisvalue + ssizeof(*this)"  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Ptr  comment:""
amc <- dmmeta.field  field:algo_lib.Ptr.pad  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Ptr.val  arg:u32  reftype:Val  dflt:"u32(thisvalue + this->pad)"  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Msg  comment:""
amc <- dmmeta.field  field:algo_lib.Msg.len  arg:u8  reftype:Val  dflt:""  comment:""
amc <- dmmeta.lenfld  field:algo_lib.Msg.len  extra:0  scale:1
amc <- dmmeta.msgtype  ctype:algo_lib.Msg  type:1
# eof amc
amc -> // --- algo_lib.Msg..Init
amc -> // Set all fields to initial values.
amc -> inline void algo_lib::Msg_Init(algo_lib::Msg& parent) {
amc ->     parent.len = u8(ssizeof(parent));
amc -> }
amc -> // --- algo_lib.Ptr..Init
amc -> // Set all fields to initial values.
amc -> inline void algo_lib::Ptr_Init(algo_lib::Ptr& parent) {
amc ->     parent.val = u32(u32(thisvalue + (&parent)->pad));
amc -> }
amc -> // --- algo_lib.Rec..Init
amc -> // Set all fields to initial values.
amc -> inline void algo_lib::Rec_Init(algo_lib::Rec& parent) {
amc ->     parent.val = u32(*thisvalue + ssizeof(parent));
amc -> }
# exit amc code:0
