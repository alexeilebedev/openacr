amc -> // --- algo_lib.Computed..FmtJson
amc -> // Create JSON representation of algo_lib::Computed under PARENT node
amc -> // cfmt:algo_lib.Computed.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::Computed_FmtJson(algo_lib::Computed& row, lib_json::FNode *parent) {
amc ->     return u32_FmtJson(row.a,parent);
amc -> }
amc -> // --- algo_lib.InlAryJson..FmtJson
amc -> // Create JSON representation of algo_lib::InlAryJson under PARENT node
amc -> // cfmt:algo_lib.InlAryJson.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::InlAryJson_FmtJson(algo_lib::InlAryJson& row, lib_json::FNode *parent) {
amc ->     algo::aryptr<u32> v_ary = v_Getary(row);
amc ->     lib_json::FNode& v_node = lib_json::NewArrayNode(parent);
amc ->     for (int i = 0; i < v_ary.n_elems; ++i) {
amc ->         u32_FmtJson(v_ary[i], &v_node);
amc ->     }
amc ->     return &v_node;
amc -> }
