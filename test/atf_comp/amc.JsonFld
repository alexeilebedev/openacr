amc -> lib_json::FNode * algo_lib::InlAryPrint_FmtJson(algo_lib::InlAryPrint& row, lib_json::FNode *parent) {
amc ->     algo::aryptr<algo_lib::Str> v_ary = v_Getary(row);
amc ->     lib_json::FNode& v_node = lib_json::NewArrayNode(parent);
amc ->     for (int i = 0; i < v_ary.n_elems; ++i) {
amc ->         algo_lib::Str_Print(v_ary[i], lib_json::NewStringNode(&v_node).value);
amc ->     }
amc ->     return &v_node;
amc -> }
