amc -> // cfmt:algo_lib.Multi.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::Multi_FmtJson(algo_lib::Multi& row, lib_json::FNode *parent) {
amc ->     lib_json::FNode *objnode = &lib_json::node_Alloc();
amc ->     objnode->p_parent = parent?parent:objnode;
amc ->     objnode->type   = lib_json_FNode_type_object;
amc ->     node_XrefMaybe(*objnode);
amc ->     lib_json::FNode *a_node = &lib_json::node_Alloc();
amc ->     a_node->p_parent = objnode;
amc ->     a_node->type   = lib_json_FNode_type_field;
amc ->     a_node->value  = "a";
amc ->     node_XrefMaybe(*a_node);
amc ->     u32_FmtJson(row.a,a_node);
amc ->     algo_lib::Str_Print(row.s, lib_json::NewStringNode(objnode, "s").value);
amc ->     algo::aryptr<u32> ja_ary = ja_Getary(row);
amc ->     lib_json::FNode& ja_node = lib_json::NewArrayNode(objnode, "ja");
amc ->     for (int i = 0; i < ja_ary.n_elems; ++i) {
amc ->         u32_FmtJson(ja_ary[i], &ja_node);
amc ->     }
amc ->     algo::aryptr<algo_lib::Str> sa_ary = sa_Getary(row);
amc ->     lib_json::FNode& sa_node = lib_json::NewArrayNode(objnode, "sa");
amc ->     for (int i = 0; i < sa_ary.n_elems; ++i) {
amc ->         algo_lib::Str_Print(sa_ary[i], lib_json::NewStringNode(&sa_node).value);
amc ->     }
amc ->     return objnode;
amc -> }
amc -> // --- algo_lib.PmFilter..FmtJson
amc -> // Create JSON representation of algo_lib::PmFilter under PARENT node
amc -> // cfmt:algo_lib.PmFilter.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::PmFilter_FmtJson(algo_lib::PmFilter& row, lib_json::FNode *parent) {
amc ->     lib_json::FNode *objnode = &lib_json::node_Alloc();
amc ->     objnode->p_parent = parent?parent:objnode;
amc ->     objnode->type   = lib_json_FNode_type_object;
amc ->     node_XrefMaybe(*objnode);
amc ->     if (a_PresentQ(row)) {
amc ->         lib_json::FNode *a_node = &lib_json::node_Alloc();
amc ->         a_node->p_parent = objnode;
amc ->         a_node->type   = lib_json_FNode_type_field;
amc ->         a_node->value  = "a";
amc ->         node_XrefMaybe(*a_node);
amc ->         u32_FmtJson(row.a,a_node);
amc ->     }
amc ->     if (s_PresentQ(row)) {
amc ->         algo_lib::Str_Print(row.s, lib_json::NewStringNode(objnode, "s").value);
amc ->     }
amc ->     if (ja_PresentQ(row)) {
amc ->         algo::aryptr<u32> ja_ary = ja_Getary(row);
amc ->         lib_json::FNode& ja_node = lib_json::NewArrayNode(objnode, "ja");
amc ->         for (int i = 0; i < ja_ary.n_elems; ++i) {
amc ->             u32_FmtJson(ja_ary[i], &ja_node);
amc ->         }
amc ->     }
amc ->     return objnode;
amc -> }
