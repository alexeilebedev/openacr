acr_compl -> -debug
acr_compl -> -dflag:N
acr_compl -> -dnum:<int>
acr_compl -> -dpkey:<pkey>
acr_compl -> -dregx:<regx>
acr_compl -> -dstr:<string>
acr_compl -> -exec
acr_compl -> -fconst:<enum>
acr_compl -> -flag
acr_compl -> -h
acr_compl -> -help
acr_compl -> -in:<string>
acr_compl -> -mdbl:<double>
acr_compl -> -mnum:<int>
acr_compl -> -mstr:<string>
acr_compl -> -sig
acr_compl -> -signature
acr_compl -> -v
acr_compl -> -verbose
acr_compl -> -version
