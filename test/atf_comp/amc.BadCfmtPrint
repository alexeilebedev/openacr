# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Sample  comment:""
amc <- dmmeta.field  field:algo_lib.Sample.value  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.Sample.Tuple  printfmt:Auto  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Compact  comment:""
amc <- dmmeta.field  field:algo_lib.Compact.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Compact.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.Compact.String  printfmt:CompactSep  read:N  print:Y  sep:,  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Quiet  comment:""
amc <- dmmeta.field  field:algo_lib.Quiet.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.Quiet.String  printfmt:CompactSep  read:N  print:N  sep:,  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CTuple  comment:""
amc <- dmmeta.field  field:algo_lib.CTuple.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CTuple.String  printfmt:Tuple  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CAuto  comment:""
amc <- dmmeta.field  field:algo_lib.CAuto.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CAuto.String  printfmt:Auto  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CRaw  comment:""
amc <- dmmeta.field  field:algo_lib.CRaw.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CRaw.String  printfmt:Raw  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CSep  comment:""
amc <- dmmeta.field  field:algo_lib.CSep.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.CSep.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CSep.String  printfmt:Sep  read:N  print:Y  sep::  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CBitset  comment:""
amc <- dmmeta.field  field:algo_lib.CBitset.a  arg:bool  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.CBitset.b  arg:bool  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CBitset.String  printfmt:Bitset  read:N  print:Y  sep:,  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CArgv  comment:""
amc <- dmmeta.field  field:algo_lib.CArgv.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CArgv.Argv  printfmt:CompactSep  read:N  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CJson  comment:""
amc <- dmmeta.field  field:algo_lib.CJson.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.CJson.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:u32.Json  printfmt:Extern  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CJson.Json  printfmt:CompactSep  read:N  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CExtern  comment:""
amc <- dmmeta.field  field:algo_lib.CExtern.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CExtern.Tuple  printfmt:Extern  read:N  print:Y  sep:""  genop:N  comment:""
# eof amc
amc -> amc.badcfmt  cfmt:algo_lib.Compact.String  strfmt:String  printfmt:CompactSep  comment:"no print path for this strfmt and printfmt"
amc -> amc.badcfmt  cfmt:algo_lib.Sample.Tuple  strfmt:Tuple  printfmt:Auto  comment:"no print path for this strfmt and printfmt"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:2
