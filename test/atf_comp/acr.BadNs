# start acr cmd:"$bindir/acr -insert -check"
acr <- dmmeta.ctype ctype:x.Y
# eof acr
acr -> stdin:1: Invalid value ns:x
acr -> dmmeta.ctype  ctype:x.Y
acr -> Type               dmmeta.Ns
acr -> Valid values       , abt, abt_md, acr, acr_compl, acr_dm, acr_ed, acr_in, acr_my, algo, algo_lib, amc, amc_gc, amc_vis, amcdb, ams, ams_sendtest, amsdb, apm, aqlite, atf, atf_amc, atf_ci, atf_cmdline, atf_comp, atf_cov, atf_fuzz, atf_gcli, atf_nrun, atf_unit, atfdb, bash2html, command, dev, dmmeta, fm, fmdb, gcache, gcli, gclidb, http, httpdb, ietf, jkv, js, kafka, lib_amcdb, lib_ams, lib_ctype, lib_curl, lib_exec, lib_fm, lib_git, lib_http, lib_iconv, lib_json, lib_mysql, lib_netio, lib_prot, lib_rl, lib_sql, lib_sqlite, lib_ws, mdbg, mysql2ssim, orgfile, report, samp_make, samp_meng, samp_regx, sampdb, sandbox, src_func, src_hdr, src_lim, ssim2csv, ssim2mysql, ssimfilt, strconv, sv2ssim, ws, wsdb
acr -> acr.badrefs  ctype:dmmeta.Ctype  nbad:1
acr -> report.acr_check  records:1  errors:3
acr -> acr.insert  dmmeta.ctype  ctype:x.Y  comment:""
acr -> report.acr  n_select:1  n_insert:1  n_delete:0  n_ignore:0  n_update:0  n_file_mod:0
# exit acr code:1
