# start acr cmd:"$bindir/acr -in:<(echo 'dmmeta.ns  ns:foo  nstype:exe  license:GPL  comment:\"\"' && echo 'dmmeta.ns  ns:bar  nstype:lib  license:GPL  comment:\"\"') -insert -check"
acr <- dmmeta.ctype ctype:x.Y
# eof acr
acr -> stdin:1: Invalid value ns:x
acr -> dmmeta.ctype  ctype:x.Y
acr -> Type               dmmeta.Ns
acr -> Valid values       foo, bar
acr -> acr.badrefs  ctype:dmmeta.Ctype  nbad:1
acr -> report.acr_check  records:1  n_err:3
acr -> acr.insert  dmmeta.ctype  ctype:x.Y  comment:""
acr -> report.acr  n_select:1  n_insert:1  n_delete:0  n_ignore:0  n_update:0  n_file_mod:0  n_badline:0
# exit acr code:1
