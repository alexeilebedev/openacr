# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u8  reftype:Malloc  dflt:""  comment:""
amc <- amcdb.bltin  ctype:u32  likeu64:Y  bigendok:Y  issigned:N  comment:""
amc <- dmmeta.ns  ns:algo  nstype:protocol  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:algo  comment:""
amc <- dmmeta.ctype  ctype:algo.Smallstr20  comment:"inline string with length field"
amc <- dmmeta.ccmp  ctype:algo.Smallstr20  extrn:N  genop:Y  order:Y  minmax:N  comment:""
amc <- dmmeta.chash  ctype:algo.Smallstr20  hashtype:CRC32  comment:""
amc <- dmmeta.cstr  ctype:algo.Smallstr20  strequiv:Y  comment:""
amc <- dmmeta.pack  ctype:algo.Smallstr20  comment:""
amc <- dmmeta.cfmt  cfmt:algo.Smallstr20.String  printfmt:Raw  read:Y  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.field  field:algo.Smallstr20.ch  arg:char  reftype:Smallstr  dflt:""  comment:""
amc <- dmmeta.fcast  field:algo.Smallstr20.ch  expr:algo::strptr  comment:""
amc <- dmmeta.smallstr  field:algo.Smallstr20.ch  length:20  strtype:rpascal  pad:""  strict:Y
amc <- dmmeta.ns  ns:pbt  nstype:protocol  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:pbt  comment:""
amc <- dmmeta.ctype  ctype:pbt.Msg  comment:""
amc <- dmmeta.field  field:pbt.Msg.plain  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.netval  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.fbigend  field:pbt.Msg.netval  comment:""
amc <- dmmeta.field  field:pbt.Msg.flags  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.slice  arg:u32  reftype:Bitfld  dflt:""  comment:""
amc <- dmmeta.bitfld  field:pbt.Msg.slice  offset:0  width:8  srcfield:pbt.Msg.flags  comment:""
amc <- dmmeta.field  field:pbt.Msg.computed  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cppfunc  field:pbt.Msg.computed  expr:"parent.plain"  print:N  set:Y
amc <- dmmeta.field  field:pbt.Msg.readonly  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cppfunc  field:pbt.Msg.readonly  expr:"parent.plain"  print:N  set:N
amc <- dmmeta.field  field:pbt.Msg.addr  arg:algo.Smallstr20  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.port  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.substr  field:pbt.Msg.port  expr:/RR  srcfield:pbt.Msg.addr
amc <- dmmeta.field  field:pbt.Msg.alias  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.falias  field:pbt.Msg.alias  srcfield:pbt.Msg.plain  comment:""
amc <- dmmeta.cpbuf  ctype:pbt.Msg  syntax:proto3  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.plain  field_number:1  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.netval  field_number:2  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.slice  field_number:3  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.computed  field_number:4  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.readonly  field_number:5  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.port  field_number:6  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.alias  field_number:7  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.ctype  ctype:pbt.Rep  comment:""
amc <- dmmeta.field  field:pbt.Rep.plain  arg:u32  reftype:Tary  dflt:""  comment:""
amc <- dmmeta.tary  field:pbt.Rep.plain  aliased:N  comment:""
amc <- dmmeta.field  field:pbt.Rep.readonly  arg:u32  reftype:Tary  dflt:""  comment:""
amc <- dmmeta.tary  field:pbt.Rep.readonly  aliased:N  comment:""
amc <- dmmeta.cppfunc  field:pbt.Rep.readonly  expr:""  print:N  set:N
amc <- dmmeta.cpbuf  ctype:pbt.Rep  syntax:proto3  comment:""
amc <- dmmeta.fpbuf  field:pbt.Rep.plain  field_number:1  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Rep.readonly  field_number:2  pb_type:uint32  packed:N  comment:""
# eof amc
amc -> amc.pbuf_store  field:pbt.Msg.readonly  reftype:Val  comment:"fpbuf on a singular field with no generated Set; a substr, a falias or a cppfunc with set:N has a Get only"
amc -> amc.pbuf_store  field:pbt.Msg.port  reftype:Val  comment:"fpbuf on a singular field with no generated Set; a substr, a falias or a cppfunc with set:N has a Get only"
amc -> amc.pbuf_store  field:pbt.Msg.alias  reftype:Val  comment:"fpbuf on a singular field with no generated Set; a substr, a falias or a cppfunc with set:N has a Get only"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:3
