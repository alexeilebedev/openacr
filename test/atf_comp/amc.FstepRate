amc <- dmmeta.field  field:yyy.FDb.zd_out  arg:yyy.FJob  reftype:Llist  dflt:''  comment:''
amc <- dmmeta.llist  field:yyy.FDb.zd_out  havetail:Y  havecount:N  comment:''
amc <- dmmeta.xref  field:yyy.FDb.zd_out  inscond:false  via:''
amc <- dmmeta.field  field:yyy.FDb.zd_bg  arg:yyy.FJob  reftype:Llist  dflt:''  comment:''
amc <- dmmeta.llist  field:yyy.FDb.zd_bg  havetail:Y  havecount:N  comment:''
amc <- dmmeta.xref  field:yyy.FDb.zd_bg  inscond:false  via:''
amc <- dev.target  target:algo_lib
amc <- dev.target  target:yyy
amc <- dev.targdep  targdep:yyy.algo_lib  comment:''
amc <- dmmeta.fstep  fstep:yyy.FDb.zd_out  steptype:Inline  stepband:output  comment:''
amc <- dmmeta.fstep  fstep:yyy.FDb.zd_in  steptype:Inline  stepband:input  comment:''
amc <- dmmeta.fstep  fstep:algo_lib.FDb.zd_ready  steptype:Inline  stepband:work  comment:''
amc <- dmmeta.fstep  fstep:yyy.FDb.zd_bg  steptype:Inline  stepband:idle  comment:''
amc <- dmmeta.fsteprate  fstep:yyy.FDb.zd_bg  ncall:2  npass:3  comment:''
# eof amc
amc -> // --- yyy.FDb.zd_bg.Call
amc -> inline static void yyy::zd_bg_Call() {
amc ->     yyy::_db.zd_bg_credit = u32_Min(yyy::_db.zd_bg_credit + 2, 4); // fstep:yyy.FDb.zd_bg  rate:2/3
amc ->     bool called = false;
amc ->     while (!yyy::zd_bg_EmptyQ() && yyy::_db.zd_bg_credit >= 3) {
amc ->         yyy::_db.zd_bg_credit -= 3;
amc ->         yyy::zd_bg_Step();
amc ->         zd_bg_UpdateCycles();
amc ->         called = true;
amc ->     }
amc ->     if (!called && !yyy::zd_bg_EmptyQ() && algo_lib::_db.next_loop > algo_lib::_db.clock) {
amc ->         yyy::zd_bg_Step(); // stepband:idle: the pass has time to give up
amc ->         zd_bg_UpdateCycles();
amc ->     }
amc ->     if (!yyy::zd_bg_EmptyQ()) {
amc ->         algo_lib::_db.next_loop = algo_lib::_db.clock;
amc ->     }
amc -> }
# exit amc code:0
