amc <- dmmeta.steptype  steptype:Inline  comment:''
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:''  comment:''
amc <- dmmeta.ctype  ctype:algo_lib.FRow  comment:''
amc <- dmmeta.field  field:algo_lib.FRow.rowid  arg:u64  reftype:Val  dflt:''  comment:''
amc <- dmmeta.field  field:algo_lib.FDb.row  arg:algo_lib.FRow  reftype:Tpool  dflt:''  comment:''
amc <- dmmeta.field  field:algo_lib.FDb.zd_ready  arg:algo_lib.FRow  reftype:Llist  dflt:''  comment:''
