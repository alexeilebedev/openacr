amc <- dmmeta.nscpp  ns:yyy  comment:''
amc <- dmmeta.nsx  ns:yyy  genthrow:Y  pool:algo_lib.FDb.malloc
amc <- dmmeta.main  ns:yyy  ismodule:N
amc <- dmmeta.ctype  ctype:yyy.FDb  comment:''
amc <- dmmeta.field  field:yyy.FDb._db  arg:yyy.FDb  reftype:Global  dflt:''  comment:''
amc <- dmmeta.ctype  ctype:yyy.FJob  comment:''
amc <- dmmeta.field  field:yyy.FJob.id  arg:u64  reftype:Val  dflt:''  comment:''
