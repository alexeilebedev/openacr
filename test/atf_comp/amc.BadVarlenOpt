amc <- dmmeta.field  field:algo_lib.Rblob.data  arg:u8  reftype:Varlen  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Rblob.tail  arg:algo_lib.Tail  reftype:Opt  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.rblob  arg:algo_lib.Rblob  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Oblob  comment:""
amc <- dmmeta.field  field:algo_lib.Oblob.n  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Oblob.tail  arg:algo_lib.Tail  reftype:Opt  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Oblob.tail2  arg:algo_lib.Tail  reftype:Opt  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.oblob  arg:algo_lib.Oblob  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Sblob  comment:""
amc <- dmmeta.field  field:algo_lib.Sblob.n  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Sblob.tail  arg:algo_lib.Tail  reftype:Opt  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.sblob  arg:algo_lib.Sblob  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Vblob  comment:""
amc <- dmmeta.field  field:algo_lib.Vblob.n  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.lenfld  field:algo_lib.Vblob.n  extra:0  scale:1
amc <- dmmeta.field  field:algo_lib.Vblob.data  arg:u8  reftype:Varlen  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.vblob  arg:algo_lib.Vblob  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Dblob  comment:""
amc <- dmmeta.field  field:algo_lib.Dblob.n  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.lenfld  field:algo_lib.Dblob.n  extra:0  scale:1
amc <- dmmeta.field  field:algo_lib.Dblob.tail  arg:algo_lib.Tail  reftype:Opt  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Dblob.data  arg:u8  reftype:Varlen  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Dblob.data2  arg:u8  reftype:Varlen  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Wblob  comment:""
amc <- dmmeta.field  field:algo_lib.Wblob.n  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.lenfld  field:algo_lib.Wblob.n  extra:0  scale:1
