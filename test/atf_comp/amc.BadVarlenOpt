# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u8  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Blob  comment:""
amc <- dmmeta.field  field:algo_lib.Blob.n  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.lenfld  field:algo_lib.Blob.n  extra:0  scale:1
amc <- dmmeta.ctype  ctype:algo_lib.Tail  comment:""
amc <- dmmeta.field  field:algo_lib.Tail.t  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Blob.tail  arg:algo_lib.Tail  reftype:Opt  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Blob.data  arg:u8  reftype:Varlen  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.blob  arg:algo_lib.Blob  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Rblob  comment:""
amc <- dmmeta.field  field:algo_lib.Rblob.n  arg:u32  reftype:Val  dflt:""  comment:""
