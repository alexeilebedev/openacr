amc <- dmmeta.fstep  fstep:yyy.FDb.zd_bg  steptype:Inline  stepband:idle  comment:''
amc <- dmmeta.fsteprate  fstep:yyy.FDb.zd_bg  ncall:1  npass:10  comment:''
