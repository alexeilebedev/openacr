amc -> // --- yyy.FDb._db.Steps
amc -> // Call every step of this process, band by band, each band in dependency order
amc -> void yyy::Steps() {
amc ->     yyy::zd_in_Call(); // fstep:yyy.FDb.zd_in  stepband:input
amc ->     yyy::zd_work_Call(); // fstep:yyy.FDb.zd_work  stepband:work
amc ->     algo_lib::zd_ready_Call(); // fstep:algo_lib.FDb.zd_ready  stepband:work
amc ->     yyy::zd_out_Call(); // fstep:yyy.FDb.zd_out  stepband:output
amc ->     yyy::zd_bg_Call(); // fstep:yyy.FDb.zd_bg  stepband:idle
amc -> }
# exit amc code:0
