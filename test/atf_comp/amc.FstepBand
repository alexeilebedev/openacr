amc <- dmmeta.nscpp  ns:yyy  comment:''
amc <- dmmeta.nsx  ns:yyy  genthrow:Y  pool:algo_lib.FDb.malloc
amc <- dmmeta.main  ns:yyy  ismodule:N
amc <- dmmeta.ctype  ctype:yyy.FDb  comment:''
amc <- dmmeta.field  field:yyy.FDb._db  arg:yyy.FDb  reftype:Global  dflt:''  comment:''
amc <- dmmeta.ctype  ctype:yyy.FJob  comment:''
amc <- dmmeta.field  field:yyy.FJob.id  arg:u64  reftype:Val  dflt:''  comment:''
amc <- dmmeta.field  field:yyy.FDb.job  arg:yyy.FJob  reftype:Tpool  dflt:''  comment:''
amc <- dmmeta.field  field:yyy.FDb.zd_in  arg:yyy.FJob  reftype:Llist  dflt:''  comment:''
amc <- dmmeta.llist  field:yyy.FDb.zd_in  havetail:Y  havecount:N  comment:''
amc <- dmmeta.xref  field:yyy.FDb.zd_in  inscond:false  via:''
amc <- dmmeta.field  field:yyy.FDb.zd_out  arg:yyy.FJob  reftype:Llist  dflt:''  comment:''
amc <- dmmeta.llist  field:yyy.FDb.zd_out  havetail:Y  havecount:N  comment:''
amc <- dmmeta.xref  field:yyy.FDb.zd_out  inscond:false  via:''
amc <- dmmeta.field  field:yyy.FDb.zd_bg  arg:yyy.FJob  reftype:Llist  dflt:''  comment:''
amc <- dmmeta.llist  field:yyy.FDb.zd_bg  havetail:Y  havecount:N  comment:''
amc <- dmmeta.xref  field:yyy.FDb.zd_bg  inscond:false  via:''
amc <- dmmeta.field  field:yyy.FDb.zd_work  arg:yyy.FJob  reftype:Llist  dflt:''  comment:''
amc <- dmmeta.llist  field:yyy.FDb.zd_work  havetail:Y  havecount:N  comment:''
amc <- dmmeta.xref  field:yyy.FDb.zd_work  inscond:false  via:''
amc <- dev.target  target:algo_lib
amc <- dev.target  target:yyy
amc <- dev.targdep  targdep:yyy.algo_lib  comment:''
amc <- dmmeta.fstep  fstep:yyy.FDb.zd_out  steptype:Inline  stepband:output  comment:''
amc <- dmmeta.fstep  fstep:yyy.FDb.zd_in  steptype:Inline  stepband:input  comment:''
