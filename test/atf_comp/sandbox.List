dry_run: set -eu -o pipefail
(printf 'Sandbox\tSize\tClean\tPath\tComment\n'

if pushd "temp/sandbox.test1" >/dev/null 2>&1; then
  size=$(du -sh . 2>/dev/null | awk '{print $1}')
  clean=$(git diff --quiet 2>/dev/null && echo Y || echo N)
  popd >/dev/null || exit 1
else
  size=N/A
  clean=Y
fi
printf '%s\t%s\t%s\t%s\t%s\n' "test1" "$size" "$clean" "temp/sandbox.test1" "Test sandbox 1"

if pushd "temp/sandbox.test2" >/dev/null 2>&1; then
  size=$(du -sh . 2>/dev/null | awk '{print $1}')
  clean=$(git diff --quiet 2>/dev/null && echo Y || echo N)
  popd >/dev/null || exit 1
else
  size=N/A
  clean=Y
fi
printf '%s\t%s\t%s\t%s\t%s\n' "test2" "$size" "$clean" "temp/sandbox.test2" "Test sandbox 2"
) | column -t -s '	'

