amc -> // --- algo_lib.DecPlaceCast.value.qSetDouble
amc -> // Set value of field value.
amc -> // The value is rounded to the nearest integer.
amc -> // This ensures that truncation of a near-integer value does not occur.
amc -> // Example: 1.3 cannot be represented exactly as a double, the actual
amc -> // stored value will be 1.29999999. when we apply C truncation,
amc -> // we want to end up with 1.3, not 1.2.
amc -> inline void algo_lib::value_qSetDouble(algo_lib::DecPlaceCast& parent, double val) {
amc ->     double intval = val * 100 + (val > 0 ? 0.5 : -0.5);
amc ->     // set underlying field.
amc ->     parent.value = algo_lib::I64Cast(intval);
amc -> }
amc -> // --- algo_lib.DecPlaceCast.value.GetDouble
amc -> inline double algo_lib::value_GetDouble(const algo_lib::DecPlaceCast& parent) {
amc ->     double ret;
amc ->     ret = parent.value / double(100);
amc ->     return ret;
amc -> }
