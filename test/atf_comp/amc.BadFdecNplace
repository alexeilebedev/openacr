amc -> // --- algo_lib.DecPlaceCast.value.SetDoubleMaybe
amc -> // Set value of field value, using rounding.
amc -> // If value is out of range for the target type, return false.
amc -> bool algo_lib::value_SetDoubleMaybe(algo_lib::DecPlaceCast& parent, double val) {
amc ->     double intval = val * 100;
amc ->     i64 minval = i64((-9223372036854775807LL-1));
amc ->     i64 maxval = i64(9223372036854775807LL);
amc ->     bool retval = intval > double(minval) - 0.5;// minval rounds in, minval-1 rounds out
amc ->     retval &= intval < double(maxval) + 0.5;// maxval rounds in, maxval+1 rounds out
amc ->     if (retval) {
amc ->         intval = intval + (val > 0 ? 0.5 : -0.5);
amc ->         parent.value = algo_lib::I64Cast(intval); // set underlying field.
amc ->     }
amc ->     return retval;
amc -> }
amc -> // --- algo_lib.DecPlaceCast.value.ReadStrptrMaybe
amc -> bool algo_lib::value_ReadStrptrMaybe(algo_lib::DecPlaceCast& parent, algo::strptr in) {
amc ->     int index = 0;
amc ->     int neg = false;
amc ->     // skip leading sign
amc ->     if (index < in.n_elems && (in.elems[index] == '+' || in.elems[index] == '-')) {
amc ->         neg = in.elems[index]=='-';
amc ->         index++;
amc ->     };
amc ->     // parse digits
amc ->     u64 val = 0;
amc ->     int ndot = 0; // number of . encountered
amc ->     int nfrac = 0; // read up to NFRAC digits after .; if not found, fill in
amc ->     bool ok = true;// overflow or bad char
amc ->     u64 limdiv = 922337203685477580ULL;// largest magnitude the field holds for this sign, over 10
amc ->     u64 limmod = neg ? 8ULL : 7ULL;// and that magnitude's last digit
amc ->     for (; index < in.n_elems; index++) {
amc ->         char c = in.elems[index];
amc ->         if (c == '.') {
amc ->             ok &= ndot == 0; // max 1 dot
amc ->             ndot++;
amc ->         } else if (algo_lib::DigitCharQ(c)) {
amc ->             if (nfrac < 2) { // ignore digits after 2'th
amc ->                 u64 digit = c - '0';
amc ->                 ok &= val < limdiv || (val == limdiv && digit <= limmod);// val*10+digit must fit the field
amc ->                 val = val*10 + digit;
amc ->                 nfrac += ndot>0;
amc ->             }
amc ->         } else {
amc ->             ok = false; // unknown char
amc ->         }
amc ->     }
amc ->     while (nfrac < 2) {// insert missing
amc ->         ok &= val <= limdiv;// val*10 must fit the field
amc ->         val = val*10;
amc ->         nfrac++;
amc ->     }
amc ->     i64 final_val = i64(neg ? 0 - val : val);// negate in u64: -val at the type minimum has no positive form
amc ->     if (ok) {
amc ->         parent.value = algo_lib::I64Cast(final_val);// store value
amc ->     }
amc ->     return ok;
amc -> }
