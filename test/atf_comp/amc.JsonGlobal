amc ->     lib_json::FNode *objnode = &lib_json::node_Alloc();
amc ->     objnode->p_parent = parent?parent:objnode;
amc ->     objnode->type   = lib_json_FNode_type_object;
amc ->     node_XrefMaybe(*objnode);
amc ->     algo::aryptr<u32> v_ary = v_Getary();
amc ->     lib_json::FNode& v_node = lib_json::NewArrayNode(objnode, "v");
amc ->     for (int i = 0; i < v_ary.n_elems; ++i) {
amc ->         u32_Print(v_ary[i], lib_json::NewStringNode(&v_node).value);
amc ->     }
amc ->     return objnode;
amc ->     (void)row;//only to avoid -Wunused-parameter
amc -> }
