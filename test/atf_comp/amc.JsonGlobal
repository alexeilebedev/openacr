# start amc cmd:"$bindir/amc -in_dir:test/amc/json_global.ssim -out_dir: -report:N %.FmtJson"
# eof amc
amc -> // --- algo_lib.Anchor..FmtJson
amc -> // Create JSON representation of algo_lib::Anchor under PARENT node
amc -> // cfmt:algo_lib.Anchor.Json  printfmt:Auto
amc -> lib_json::FNode * algo_lib::Anchor_FmtJson(algo_lib::Anchor& row, lib_json::FNode *parent) {
amc ->     lib_json::FNode *objnode = &lib_json::node_Alloc();
amc ->     objnode->p_parent = parent?parent:objnode;
amc ->     objnode->type   = lib_json_FNode_type_object;
amc ->     node_XrefMaybe(*objnode);
amc ->     return objnode;
amc ->     (void)row;//only to avoid -Wunused-parameter
amc -> }
