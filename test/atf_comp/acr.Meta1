# start acr cmd:"$bindir/acr anonfld -meta -report:N"
# eof acr
acr -> dmmeta.ctype  ctype:dmmeta.Anonfld  comment:"Omit field name where possible (command line, enums, constants)"
acr ->   dmmeta.cpptype  ctype:dmmeta.Anonfld  ctor:Y
acr ->   dmmeta.field  field:dmmeta.Anonfld.field    arg:dmmeta.Field  reftype:Pkey  dflt:""  comment:""
acr ->   dmmeta.field  field:dmmeta.Anonfld.comment  arg:algo.Comment  reftype:Val  dflt:""  comment:""
acr ->   dmmeta.cfmt  cfmt:dmmeta.Anonfld.String  printfmt:Tuple  read:Y  print:Y  sep:""  genop:Y  comment:""
acr ->   dmmeta.ctypelen  ctype:dmmeta.Anonfld  len:304  alignment:1  padbytes:0  plaindata:Y
# exit acr code:0
