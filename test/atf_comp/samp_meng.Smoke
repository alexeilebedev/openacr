# start samp_meng cmd:$bindir/samp_meng
samp_meng <- samp_meng.TextMsg text:"configure"
samp_meng <- samp_meng.NewSymbolReqMsg symbol:A
samp_meng <- samp_meng.NewSymbolReqMsg symbol:B
samp_meng <- samp_meng.NewSymbolReqMsg symbol:C
samp_meng <- samp_meng.NewSymbolReqMsg symbol:D
samp_meng <- samp_meng.NewUserReqMsg user:1
samp_meng <- samp_meng.NewUserReqMsg user:2
samp_meng <- samp_meng.NewUserReqMsg user:3
samp_meng <- samp_meng.NewUserReqMsg user:4
samp_meng <- samp_meng.TextMsg text:"place 2 buy orders on the book"
samp_meng <- samp_meng.NewOrderReqMsg user:1 symbol:A price:10.0 qty:100 ioc:false
samp_meng <- samp_meng.NewOrderReqMsg user:1 symbol:A price:10.0 qty:100 ioc:false
samp_meng <- samp_meng.TextMsg text:"sell order incoming, takes out both orders"
samp_meng <- samp_meng.NewOrderReqMsg user:2 symbol:A price:10.0 qty:-300 ioc:false
samp_meng <- samp_meng.TextMsg text:"sell IOC order incoming, does nothing"
samp_meng <- samp_meng.NewOrderReqMsg user:2 symbol:A price:10.0 qty:-300 ioc:true
samp_meng <- samp_meng.TextMsg text:"buy order incoming, matches sell side, price improved, rest cancels back"
samp_meng <- samp_meng.NewOrderReqMsg user:3 symbol:A price:11.0 qty:200 ioc:true
samp_meng <- samp_meng.TextMsg text:"place a few orders; and mass-cancel others"
samp_meng <- samp_meng.NewOrderReqMsg user:3 symbol:B price:10.0 qty:100 ioc:false
samp_meng <- samp_meng.NewOrderReqMsg user:3 symbol:B price:10.0 qty:100 ioc:false
samp_meng <- samp_meng.NewOrderReqMsg user:3 symbol:B price:10.0 qty:100 ioc:false
samp_meng <- samp_meng.MassCancelReqMsg user:3
# eof samp_meng
samp_meng -> input: samp_meng.TextMsg  text:configure
samp_meng -> input: samp_meng.NewSymbolReqMsg  symbol:A
samp_meng -> samp_meng.NewSymbolMsg  symbol:A
samp_meng -> input: samp_meng.NewSymbolReqMsg  symbol:B
samp_meng -> samp_meng.NewSymbolMsg  symbol:B
samp_meng -> input: samp_meng.NewSymbolReqMsg  symbol:C
samp_meng -> samp_meng.NewSymbolMsg  symbol:C
samp_meng -> input: samp_meng.NewSymbolReqMsg  symbol:D
samp_meng -> samp_meng.NewSymbolMsg  symbol:D
samp_meng -> input: samp_meng.NewUserReqMsg  user:1
samp_meng -> samp_meng.NewUserMsg  user:1
samp_meng -> input: samp_meng.NewUserReqMsg  user:2
samp_meng -> samp_meng.NewUserMsg  user:2
samp_meng -> input: samp_meng.NewUserReqMsg  user:3
samp_meng -> samp_meng.NewUserMsg  user:3
samp_meng -> input: samp_meng.NewUserReqMsg  user:4
samp_meng -> samp_meng.NewUserMsg  user:4
samp_meng -> input: samp_meng.TextMsg  text:"place 2 buy orders on the book"
samp_meng -> input: samp_meng.NewOrderReqMsg  ioc:N  qty:100  price:10  symbol:A  user:1
samp_meng -> samp_meng.NewOrderMsg  time:***  price:10  order:1  symbol:A  qty:100
samp_meng -> input: samp_meng.NewOrderReqMsg  ioc:N  qty:100  price:10  symbol:A  user:1
samp_meng -> samp_meng.NewOrderMsg  time:***  price:10  order:2  symbol:A  qty:100
samp_meng -> input: samp_meng.TextMsg  text:"sell order incoming, takes out both orders"
samp_meng -> input: samp_meng.NewOrderReqMsg  ioc:N  qty:-300  price:10  symbol:A  user:2
samp_meng -> samp_meng.OrderTradeMsg  order:2  qty:100  price:10
samp_meng -> samp_meng.CancelOrderMsg  order:2
samp_meng -> samp_meng.OrderTradeMsg  order:1  qty:100  price:10
samp_meng -> samp_meng.CancelOrderMsg  order:1
samp_meng -> samp_meng.NewOrderMsg  time:***  price:10  order:3  symbol:A  qty:100
samp_meng -> input: samp_meng.TextMsg  text:"sell IOC order incoming, does nothing"
samp_meng -> input: samp_meng.NewOrderReqMsg  ioc:Y  qty:-300  price:10  symbol:A  user:2
samp_meng -> input: samp_meng.TextMsg  text:"buy order incoming, matches sell side, price improved, rest cancels back"
samp_meng -> input: samp_meng.NewOrderReqMsg  ioc:Y  qty:200  price:11  symbol:A  user:3
samp_meng -> samp_meng.OrderTradeMsg  order:3  qty:100  price:10
samp_meng -> samp_meng.CancelOrderMsg  order:3
samp_meng -> input: samp_meng.TextMsg  text:"place a few orders; and mass-cancel others"
samp_meng -> input: samp_meng.NewOrderReqMsg  ioc:N  qty:100  price:10  symbol:B  user:3
samp_meng -> samp_meng.NewOrderMsg  time:***  price:10  order:6  symbol:B  qty:100
samp_meng -> input: samp_meng.NewOrderReqMsg  ioc:N  qty:100  price:10  symbol:B  user:3
samp_meng -> samp_meng.NewOrderMsg  time:***  price:10  order:7  symbol:B  qty:100
samp_meng -> input: samp_meng.NewOrderReqMsg  ioc:N  qty:100  price:10  symbol:B  user:3
samp_meng -> samp_meng.NewOrderMsg  time:***  price:10  order:8  symbol:B  qty:100
samp_meng -> input: samp_meng.MassCancelReqMsg  user:3
samp_meng -> samp_meng.CancelOrderMsg  order:6
samp_meng -> samp_meng.CancelOrderMsg  order:7
samp_meng -> samp_meng.CancelOrderMsg  order:8
# exit samp_meng code:0
