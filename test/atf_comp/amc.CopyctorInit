# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N algo_lib.Rec..CopyCtor < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Rec  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.grow  arg:u32  reftype:Inlary  dflt:""  comment:""
amc <- dmmeta.inlary  field:algo_lib.Rec.grow  min:1  max:4  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.fix  arg:u32  reftype:Inlary  dflt:"u32(gparent.n)"  comment:""
amc <- dmmeta.inlary  field:algo_lib.Rec.fix  min:4  max:4  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.size  arg:u32  reftype:Inlary  dflt:"u32(ssizeof(*this))"  comment:""
amc <- dmmeta.inlary  field:algo_lib.Rec.size  min:4  max:4  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.lit  arg:u32  reftype:Inlary  dflt:"7"  comment:""
amc <- dmmeta.inlary  field:algo_lib.Rec.lit  min:4  max:4  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.str  arg:u32  reftype:Inlary  dflt:'u32(sizeof("parent"))'  comment:""
amc <- dmmeta.inlary  field:algo_lib.Rec.str  min:4  max:4  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.note  arg:u32  reftype:Inlary  dflt:"u32(1 /* parent */)"  comment:""
amc <- dmmeta.inlary  field:algo_lib.Rec.note  min:4  max:4  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.chr  arg:u32  reftype:Inlary  dflt:"u32('\"') + u32(sizeof(parent))"  comment:""
amc <- dmmeta.inlary  field:algo_lib.Rec.chr  min:4  max:4  comment:""
amc <- dmmeta.field  field:algo_lib.Rec.raw  arg:u32  reftype:Inlary  dflt:'u32(sizeof(R"(a "parent" b)"))'  comment:""
amc <- dmmeta.inlary  field:algo_lib.Rec.raw  min:4  max:4  comment:""
# eof amc
amc -> // --- algo_lib.Rec..CopyCtor
amc -> inline  algo_lib::Rec::Rec(const algo_lib::Rec &rhs) {
amc ->     grow_n = 0; // grow: initialize count
amc ->     // min size
amc ->     for (int i = 0; i < 1; i++) {
amc ->         u32 &elem = grow_Alloc(*this);
amc ->         (void)elem; // will succeed -- min <= max
amc ->     }
amc ->     grow_Setary(*this, grow_Getary(const_cast<algo_lib::Rec&>(rhs)));
amc ->     for (int i = 0; i < 4; i++) {
amc ->         fix_elems[i] = u32(gparent.n);
amc ->     }
amc ->     fix_Setary(*this, fix_Getary(const_cast<algo_lib::Rec&>(rhs)));
amc ->     for (int i = 0; i < 4; i++) {
amc ->         size_elems[i] = u32(ssizeof(*this));
amc ->     }
amc ->     size_Setary(*this, size_Getary(const_cast<algo_lib::Rec&>(rhs)));
amc ->     for (int i = 0; i < 4; i++) {
amc ->         lit_elems[i] = 7;
amc ->     }
amc ->     lit_Setary(*this, lit_Getary(const_cast<algo_lib::Rec&>(rhs)));
amc ->     for (int i = 0; i < 4; i++) {
amc ->         str_elems[i] = u32(sizeof("parent"));
amc ->     }
amc ->     str_Setary(*this, str_Getary(const_cast<algo_lib::Rec&>(rhs)));
amc ->     for (int i = 0; i < 4; i++) {
amc ->         note_elems[i] = u32(1 /* parent */);
amc ->     }
amc ->     note_Setary(*this, note_Getary(const_cast<algo_lib::Rec&>(rhs)));
amc ->     for (int i = 0; i < 4; i++) {
amc ->         chr_elems[i] = u32('"') + u32(sizeof(*this));
amc ->     }
amc ->     chr_Setary(*this, chr_Getary(const_cast<algo_lib::Rec&>(rhs)));
amc ->     for (int i = 0; i < 4; i++) {
amc ->         raw_elems[i] = u32(sizeof(R"(a "parent" b)"));
amc ->     }
amc ->     raw_Setary(*this, raw_Getary(const_cast<algo_lib::Rec&>(rhs)));
amc -> }
# exit amc code:0
