# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u8  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ns  ns:pbt  nstype:protocol  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:pbt  comment:""
amc <- dmmeta.ctype  ctype:pbt.Msg  comment:""
amc <- dmmeta.field  field:pbt.Msg.pmask  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.pmaskfld  field:pbt.Msg.pmask  filter_print:Y  comment:""
amc <- dmmeta.field  field:pbt.Msg.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.plain  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cpbuf  ctype:pbt.Msg  syntax:proto3  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.a  field_number:1  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.b  field_number:2  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.plain  field_number:3  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbufcase  fpbufcase:pbt.Msg.a/payload  comment:""
amc <- dmmeta.fpbufcase  fpbufcase:pbt.Msg.b/payload  comment:""
amc <- dmmeta.ctype  ctype:pbt.NoMask  comment:""
amc <- dmmeta.field  field:pbt.NoMask.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.NoMask.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cpbuf  ctype:pbt.NoMask  syntax:proto3  comment:""
amc <- dmmeta.fpbuf  field:pbt.NoMask.a  field_number:1  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.NoMask.b  field_number:2  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbufcase  fpbufcase:pbt.NoMask.a/payload  comment:""
amc <- dmmeta.fpbufcase  fpbufcase:pbt.NoMask.b/payload  comment:""
amc <- dmmeta.ctype  ctype:pbt.Split  comment:""
amc <- dmmeta.field  field:pbt.Split.pmask1  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.pmaskfld  field:pbt.Split.pmask1  filter_print:N  comment:""
amc <- dmmeta.field  field:pbt.Split.pmask2  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.pmaskfld  field:pbt.Split.pmask2  filter_print:N  comment:""
amc <- dmmeta.field  field:pbt.Split.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Split.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.pmaskfld_member  pmaskfld_member:pbt.Split.pmask1/pbt.Split.a  comment:""
amc <- dmmeta.pmaskfld_member  pmaskfld_member:pbt.Split.pmask2/pbt.Split.b  comment:""
amc <- dmmeta.cpbuf  ctype:pbt.Split  syntax:proto3  comment:""
amc <- dmmeta.fpbuf  field:pbt.Split.a  field_number:1  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Split.b  field_number:2  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbufcase  fpbufcase:pbt.Split.a/payload  comment:""
amc <- dmmeta.fpbufcase  fpbufcase:pbt.Split.b/payload  comment:""
amc <- dmmeta.ctype  ctype:pbt.Half  comment:""
amc <- dmmeta.field  field:pbt.Half.pmask  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.pmaskfld  field:pbt.Half.pmask  filter_print:Y  comment:""
amc <- dmmeta.field  field:pbt.Half.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Half.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.pmaskfld_member  pmaskfld_member:pbt.Half.pmask/pbt.Half.a  comment:""
amc <- dmmeta.cpbuf  ctype:pbt.Half  syntax:proto3  comment:""
amc <- dmmeta.fpbuf  field:pbt.Half.a  field_number:1  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Half.b  field_number:2  pb_type:uint32  packed:N  comment:""
amc <- dmmeta.fpbufcase  fpbufcase:pbt.Half.a/payload  comment:""
amc <- dmmeta.fpbufcase  fpbufcase:pbt.Half.b/payload  comment:""
# eof amc
amc -> amc.pbuf_oneof  fpbufcase:pbt.NoMask.a/payload  ctype:pbt.NoMask  comment:"every variant of a oneof must be a member of one shared pmask; without it the encoder writes every non-default variant"
amc -> amc.pbuf_oneof  fpbufcase:pbt.Split.a/payload  ctype:pbt.Split  comment:"every variant of a oneof must be a member of one shared pmask; without it the encoder writes every non-default variant"
amc -> amc.pbuf_oneof  fpbufcase:pbt.Half.a/payload  ctype:pbt.Half  comment:"every variant of a oneof must be a member of one shared pmask; without it the encoder writes every non-default variant"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:3
