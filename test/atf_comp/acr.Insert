# start acr cmd:"$bindir/acr -insert ns:ns%"
acr <- dmmeta.ns  ns:ns1        nstype:exe      license:GPL   comment:"This record will be inserted"
acr <- dmmeta.ns  ns:ns2        nstype:lib      license:GPL   comment:"So will this one"
# eof acr
acr -> acr.insert  dmmeta.ns  ns:ns1  nstype:exe  license:GPL  comment:"This record will be inserted"
acr -> acr.insert  dmmeta.ns  ns:ns2  nstype:lib  license:GPL  comment:"So will this one"
acr -> report.acr  n_select:2  n_insert:2  n_delete:0  n_ignore:0  n_update:0  n_file_mod:0  n_badline:0
# exit acr code:0
