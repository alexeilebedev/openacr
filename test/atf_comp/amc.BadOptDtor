# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- amcdb.bltin  ctype:i8  likeu64:Y  bigendok:N  issigned:Y  comment:""
amc <- amcdb.bltin  ctype:u8  likeu64:Y  bigendok:N  issigned:N  comment:""
amc <- dmmeta.ccmp  ctype:u8  extrn:N  genop:N  order:Y  minmax:Y  comment:""
amc <- amcdb.bltin  ctype:i16  likeu64:Y  bigendok:Y  issigned:Y  comment:""
amc <- amcdb.bltin  ctype:u16  likeu64:Y  bigendok:Y  issigned:N  comment:""
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- amcdb.bltin  ctype:i32  likeu64:Y  bigendok:Y  issigned:Y  comment:""
amc <- amcdb.bltin  ctype:u32  likeu64:Y  bigendok:Y  issigned:N  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- amcdb.bltin  ctype:i64  likeu64:Y  bigendok:Y  issigned:Y  comment:""
amc <- amcdb.bltin  ctype:u64  likeu64:Y  bigendok:Y  issigned:N  comment:""
amc <- amcdb.bltin  ctype:u128  likeu64:N  bigendok:N  issigned:N  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- amcdb.bltin  ctype:bool  likeu64:Y  bigendok:N  issigned:N  comment:""
amc <- amcdb.bltin  ctype:char  likeu64:Y  bigendok:N  issigned:N  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Opaque  comment:""
amc <- dmmeta.cextern  ctype:algo_lib.Opaque  initmemset:N  isstruct:Y  plaindata:N
amc <- dmmeta.csize  ctype:algo_lib.Opaque  size:8  alignment:8  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.PlainElem  comment:""
amc <- dmmeta.pack  ctype:algo_lib.PlainElem  comment:""
amc <- dmmeta.field  field:algo_lib.PlainElem.value  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.MsgVarlenDtor  comment:""
amc <- dmmeta.pack  ctype:algo_lib.MsgVarlenDtor  comment:""
amc <- dmmeta.field  field:algo_lib.MsgVarlenDtor.head  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.MsgVarlenDtor.tail  arg:algo_lib.Opaque  reftype:Varlen  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.MsgOptDtor  comment:""
amc <- dmmeta.pack  ctype:algo_lib.MsgOptDtor  comment:""
amc <- dmmeta.field  field:algo_lib.MsgOptDtor.head  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.MsgOptDtor.tail  arg:algo_lib.Opaque  reftype:Opt  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.MsgVarlenPlain  comment:""
amc <- dmmeta.pack  ctype:algo_lib.MsgVarlenPlain  comment:""
amc <- dmmeta.field  field:algo_lib.MsgVarlenPlain.head  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.MsgVarlenPlain.tail  arg:algo_lib.PlainElem  reftype:Varlen  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.MsgOptPlain  comment:""
amc <- dmmeta.pack  ctype:algo_lib.MsgOptPlain  comment:""
amc <- dmmeta.field  field:algo_lib.MsgOptPlain.head  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.MsgOptPlain.tail  arg:algo_lib.PlainElem  reftype:Opt  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.MsgValDtor  comment:""
amc <- dmmeta.pack  ctype:algo_lib.MsgValDtor  comment:""
amc <- dmmeta.field  field:algo_lib.MsgValDtor.body  arg:algo_lib.Opaque  reftype:Val  dflt:""  comment:""
# eof amc
amc -> amc.opt_dtor  field:algo_lib.MsgVarlenDtor.tail  ctype:algo_lib.Opaque  reftype:Varlen  comment:"element type of a Varlen/Opt field must have no destructor"
amc -> amc.opt_dtor  field:algo_lib.MsgOptDtor.tail  ctype:algo_lib.Opaque  reftype:Opt  comment:"element type of a Varlen/Opt field must have no destructor"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:2
