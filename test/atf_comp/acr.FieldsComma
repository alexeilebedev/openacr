# start acr cmd:"$bindir/acr -in:- ns -field:nstype,comment"
acr <- dmmeta.ns  ns:ns1        nstype:exe       comment:"comment 1"
acr <- dmmeta.ns  ns:ns2      nstype:ssimdb    comment:"comment 2"
acr <- dmmeta.ns  ns:ns3         nstype:protocol  comment:"comment 3"
# eof acr
acr -> exe	comment 1
acr -> ssimdb	comment 2
acr -> protocol	comment 3
# exit acr code:0
