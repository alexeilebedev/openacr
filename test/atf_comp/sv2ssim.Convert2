# start sv2ssim cmd:"$bindir/sv2ssim test/csv/1.csv -ctype a.B -schema -data -outseparator:, -header:N"
# eof sv2ssim
sv2ssim -> John,Doe,"120 jefferson st.",Riverside,NJ,08075
sv2ssim -> Jack,McGinnis,"220 hobo Av.",Phila,PA,09119
sv2ssim -> "John ""Da Man""",Repici,"120 Jefferson St.",Riverside,NJ,08075
sv2ssim -> Stephen,Tyler,"7452 Terrace ""At the Plaza"" road",SomeTown,SD,91234
sv2ssim -> Blankman,,SomeTown,SD,00298
sv2ssim -> "Joan ""the bone"", Anne",Jet,"9th, at Terrace plc","Desert City",CO,00123
sv2ssim -> sv2ssim.report  n_line:6  n_nonempty_line:6  n_field:6  n_wideline:1
sv2ssim -> dmmeta.ctype  ctype:a.B  comment:""
sv2ssim -> dmmeta.cfmt  cfmt:a.B.String  printfmt:Tuple  read:Y  print:Y  sep:""  genop:Y  comment:""
sv2ssim -> dmmeta.field  field:a.B.field0  arg:algo.Smallstr25  reftype:Val  dflt:""  comment:field0
sv2ssim -> dmmeta.field  field:a.B.field1  arg:algo.Smallstr10  reftype:Val  dflt:""  comment:field1
sv2ssim -> dmmeta.field  field:a.B.field2  arg:u32  reftype:Val  dflt:""  comment:field2
sv2ssim -> dmmeta.field  field:a.B.field3  arg:algo.Smallstr25  reftype:Val  dflt:""  comment:field3
sv2ssim -> dmmeta.field  field:a.B.field4  arg:algo.Smallstr10  reftype:Val  dflt:""  comment:field4
sv2ssim -> dmmeta.field  field:a.B.field5  arg:u32  reftype:Val  dflt:""  comment:field5
# exit sv2ssim code:0
