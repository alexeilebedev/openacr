# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N 'pbt.Msg..PbufEncode|pbt.Msg..PbufDecode|pbt.Msg.val.Set' < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u8  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ns  ns:pbt  nstype:protocol  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:pbt  comment:""
amc <- dmmeta.ctype  ctype:pbt.Msg  comment:""
amc <- dmmeta.field  field:pbt.Msg.pmask  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.pmaskfld  field:pbt.Msg.pmask  filter_print:N  comment:""
amc <- dmmeta.field  field:pbt.Msg.flags  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.val  arg:u32  reftype:Bitfld  dflt:""  comment:""
amc <- dmmeta.bitfld  field:pbt.Msg.val  offset:0  width:8  srcfield:pbt.Msg.flags  comment:""
amc <- dmmeta.cpbuf  ctype:pbt.Msg  syntax:proto3  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.val  field_number:1  pb_type:uint32  packed:N  comment:""
# eof amc
amc -> // --- pbt.Msg.val.Set
amc -> // Set bitfield in value of field 'flags'
amc -> //    8 bits starting at bit 0.
amc -> inline void pbt::val_Set(pbt::Msg& parent, u32 rhs) {
amc ->     u32 t1    = u32(0xff) << 0;
amc ->     u32 t2    = (u32(rhs) & 0xff) << 0;
amc ->     flags_Set(parent, u32((parent.flags & ~t1) | t2));
amc -> }
amc -> // --- pbt.Msg..PbufEncode
amc -> void pbt::Msg_PbufEncode(algo::ByteAry& buf, pbt::Msg& parent) {
amc ->     if (val_PresentQ(parent)) {
amc ->         lib_pb::EncodeTag(buf,1,0);
amc ->         lib_pb::EncodeVarintU32(buf,val_Get(parent));
amc ->     }
amc -> }
amc -> // --- pbt.Msg..PbufDecode
amc -> bool pbt::Msg_PbufDecode(algo::memptr& buf, pbt::Msg& parent) {
amc ->     bool ok = true;
amc ->     while (ok && elems_N(buf) > 0) {
amc ->         u32 pb_field_number(0);
amc ->         u8 pb_wire_type(0);
amc ->         ok = lib_pb::DecodeTag(buf,pb_field_number,pb_wire_type);
amc ->         if (!ok) {
amc ->             break;
amc ->         }
amc ->         switch (pb_field_number) {
amc ->             case 1: {
amc ->                 if (pb_wire_type == 0) {
amc ->                     u32 val_tmp = u32();
amc ->                     ok = ok && lib_pb::DecodeVarintU32(buf,val_tmp);
amc ->                     val_Set(parent, val_tmp);
amc ->                     val_SetPresent(parent);
amc ->                 } else {
amc ->                     ok = lib_pb::SkipField(buf,pb_wire_type);
amc ->                 }
amc ->             } break;
amc ->             default:
amc ->             ok = lib_pb::SkipField(buf,pb_wire_type);
amc ->             break;
amc ->         }
amc ->     }
amc ->     return ok;
amc -> }
# exit amc code:0
