# start acr cmd:"$bindir/acr -insert -check"
acr <- dmmeta.field field:command.acr_ed.blah arg:bool
# eof acr
acr -> stdin:1: Invalid value reftype:
acr -> dmmeta.field  field:command.acr_ed.blah  arg:bool
acr -> Type               dmmeta.Reftype
acr -> Valid values       Alias, Atree, Base, Bheap, Bitfld, Blkpool, Charset, Count, Cppstack, Ctype, Delptr, Exec, Fbuf, Global, Hook, Inlary, Lary, Llist, Lpool, Malloc, Opt, Pkey, Ptr, Ptrary, Regx, RegxSql, Sbrk, Smallstr, Tary, Thash, Tpool, Upptr, Val, Varlen, ZSListMT
acr -> acr.badrefs  ctype:dmmeta.Field  nbad:1
acr -> report.acr_check  records:1  errors:3
acr -> acr.insert  dmmeta.field  field:command.acr_ed.blah  arg:bool  reftype:Val  dflt:""  comment:""
acr -> report.acr  n_select:1  n_insert:1  n_delete:0  n_ignore:0  n_update:0  n_file_mod:0
# exit acr code:1
