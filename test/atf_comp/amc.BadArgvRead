# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.ns  ns:command  nstype:lib  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:command  comment:""
amc <- dmmeta.ns  ns:okapp  nstype:lib  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:okapp  comment:""
amc <- dmmeta.ns  ns:noreadapp  nstype:lib  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:noreadapp  comment:""
amc <- dmmeta.ns  ns:gnuapp  nstype:lib  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:gnuapp  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Cmdline  comment:"base command line that generates both companions the reader calls"
amc <- dmmeta.field  field:algo_lib.Cmdline.help  arg:bool  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Cmdline.verbose  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.Cmdline.Argv  printfmt:Auto  read:Y  print:N  sep:""  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CmdlineNoread  comment:"base command line whose Argv cfmt is read:N: no NArgs"
amc <- dmmeta.field  field:algo_lib.CmdlineNoread.help  arg:bool  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CmdlineNoread.Argv  printfmt:Auto  read:N  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.CmdlineRaw  comment:"base command line whose only read cfmt is Raw: no ReadFieldMaybe"
amc <- dmmeta.field  field:algo_lib.CmdlineRaw.help  arg:bool  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.CmdlineRaw.Argv  printfmt:Raw  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.cmdline  arg:algo_lib.Cmdline  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.cmdline_noread  arg:algo_lib.CmdlineNoread  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.cmdline_raw  arg:algo_lib.CmdlineRaw  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:command.good  comment:"accept: Argv read:Y, printfmt Auto, base generates both companions"
amc <- dmmeta.field  field:command.good.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:command.good.Argv  printfmt:Auto  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.good  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
amc <- dmmeta.ctype  ctype:command.goodnobase  comment:"accept: no basecmdline, so the reader calls no base companion"
amc <- dmmeta.field  field:command.goodnobase.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:command.goodnobase.Argv  printfmt:Auto  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.goodnobase  read:Y  basecmdline:""  comment:""
amc <- dmmeta.ctype  ctype:command.goodraw  comment:"accept: the Argv cfmt is Raw but the String cfmt supplies ReadFieldMaybe and GetAnon"
amc <- dmmeta.field  field:command.goodraw.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:command.goodraw.name  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.anonfld  field:command.goodraw.name  comment:""
amc <- dmmeta.cfmt  cfmt:command.goodraw.Argv  printfmt:Raw  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.cfmt  cfmt:command.goodraw.String  printfmt:Tuple  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.goodraw  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
amc <- dmmeta.ctype  ctype:command.raw  comment:"reject: the only read cfmt is Raw, so neither ReadFieldMaybe nor GetAnon"
amc <- dmmeta.field  field:command.raw.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:command.raw.name  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.anonfld  field:command.raw.name  comment:""
amc <- dmmeta.cfmt  cfmt:command.raw.Argv  printfmt:Raw  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.raw  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
amc <- dmmeta.ctype  ctype:command.xtern  comment:"reject: the only read cfmt is Extern, so no ReadFieldMaybe"
amc <- dmmeta.field  field:command.xtern.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:command.xtern.Argv  printfmt:Extern  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.xtern  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
amc <- dmmeta.ctype  ctype:command.basenoread  comment:"reject: the base's Argv cfmt is read:N, so no base NArgs"
amc <- dmmeta.field  field:command.basenoread.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:command.basenoread.Argv  printfmt:Auto  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.basenoread  read:Y  basecmdline:algo_lib.FDb.cmdline_noread  comment:""
amc <- dmmeta.ctype  ctype:command.baseraw  comment:"reject: the base's only read cfmt is Raw, so no base ReadFieldMaybe"
amc <- dmmeta.field  field:command.baseraw.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:command.baseraw.Argv  printfmt:Auto  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.baseraw  read:Y  basecmdline:algo_lib.FDb.cmdline_raw  comment:""
amc <- dmmeta.ctype  ctype:command.noread  comment:"reject at the namespace: Argv cfmt is read:N, so no command.noread_ReadArgv"
amc <- dmmeta.field  field:command.noread.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:command.noread.Argv  printfmt:Auto  read:N  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.noread  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
amc <- dmmeta.ctype  ctype:command.gnu  comment:"reject at the namespace: only an ArgvGnu cfmt, which generates no reader"
amc <- dmmeta.field  field:command.gnu.limit  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:command.gnu.ArgvGnu  printfmt:Auto  read:Y  print:Y  sep:""  genop:N  comment:""
amc <- dmmeta.ccmdline  ctype:command.gnu  read:Y  basecmdline:algo_lib.FDb.cmdline  comment:""
amc <- dmmeta.ctype  ctype:okapp.FDb  comment:""
amc <- dmmeta.field  field:okapp.FDb._db  arg:okapp.FDb  reftype:Global  dflt:""  comment:""
amc <- dmmeta.field  field:okapp.FDb.cmdline  arg:command.good  reftype:Val  dflt:""  comment:""
amc <- dmmeta.main  ns:okapp  ismodule:N
amc <- dmmeta.ctype  ctype:noreadapp.FDb  comment:""
amc <- dmmeta.field  field:noreadapp.FDb._db  arg:noreadapp.FDb  reftype:Global  dflt:""  comment:""
amc <- dmmeta.field  field:noreadapp.FDb.cmdline  arg:command.noread  reftype:Val  dflt:""  comment:""
amc <- dmmeta.main  ns:noreadapp  ismodule:N
amc <- dmmeta.ctype  ctype:gnuapp.FDb  comment:""
amc <- dmmeta.field  field:gnuapp.FDb._db  arg:gnuapp.FDb  reftype:Global  dflt:""  comment:""
amc <- dmmeta.field  field:gnuapp.FDb.cmdline  arg:command.gnu  reftype:Val  dflt:""  comment:""
amc <- dmmeta.main  ns:gnuapp  ismodule:N
# eof amc
amc -> amc.badargvread  reader:noreadapp::ReadArgv  callee:noread_ReadArgv  comment:"cmdline ctype needs a cfmt with strfmt:Argv and read:Y"
amc -> amc.badargvread  reader:gnuapp::ReadArgv  callee:gnu_ReadArgv  comment:"cmdline ctype needs a cfmt with strfmt:Argv and read:Y"
amc -> amc.badargvread  reader:algo_lib::CmdlineRaw_ReadArgv  callee:CmdlineRaw_ReadFieldMaybe  comment:"ctype needs a read cfmt whose printfmt is neither Raw nor Extern"
amc -> amc.badargvread  reader:command::basenoread_ReadArgv  callee:CmdlineNoread_NArgs  comment:"basecmdline ctype needs a cfmt with strfmt:Argv and read:Y"
amc -> amc.badargvread  reader:command::basenoread_ReadArgv  callee:CmdlineNoread_ReadFieldMaybe  comment:"basecmdline ctype needs a read cfmt whose printfmt is neither Raw nor Extern"
amc -> amc.badargvread  reader:command::baseraw_ReadArgv  callee:CmdlineRaw_ReadFieldMaybe  comment:"basecmdline ctype needs a read cfmt whose printfmt is neither Raw nor Extern"
amc -> amc.badargvread  reader:command::raw_ReadArgv  callee:raw_GetAnon  comment:"ctype needs a read cfmt whose printfmt is neither Raw nor Extern"
amc -> amc.badargvread  reader:command::raw_ReadArgv  callee:raw_ReadFieldMaybe  comment:"ctype needs a read cfmt whose printfmt is neither Raw nor Extern"
amc -> amc.badargvread  reader:command::xtern_ReadArgv  callee:xtern_ReadFieldMaybe  comment:"ctype needs a read cfmt whose printfmt is neither Raw nor Extern"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:9
