#!/usr/bin/env bash
set -eu -o pipefail
export tempdir=temp/atf_comp/atf_comp.Smoke/run
export comptest=cat.Hello
export bindir=/bin
export in_raw=temp/atf_comp/atf_comp.Smoke/run/cat.Hello.in.raw
export out_raw=temp/atf_comp/atf_comp.Smoke/run/cat.Hello.out.raw
export finput=temp/atf_comp/atf_comp.Smoke/run/cat.Hello.in
export foutput=temp/atf_comp/atf_comp.Smoke/run/cat.Hello.out
mkdir -p temp/atf_comp/atf_comp.Smoke/run
cat > temp/atf_comp/atf_comp.Smoke/run/cat.Hello.in.raw << 'ATFEOF'
b
a
ATFEOF
(sort) < temp/atf_comp/atf_comp.Smoke/run/cat.Hello.in.raw > temp/atf_comp/atf_comp.Smoke/run/cat.Hello.in
exit_code=0
{ /bin/cat; } < temp/atf_comp/atf_comp.Smoke/run/cat.Hello.in 2>&1 | tee -a temp/atf_comp/atf_comp.Smoke/run/cat.Hello.out.raw >/dev/null || exit_code=$?
(sort -r) < temp/atf_comp/atf_comp.Smoke/run/cat.Hello.out.raw > temp/atf_comp/atf_comp.Smoke/run/cat.Hello.out
exit $exit_code
