# start acr cmd:"$bindir/acr -in:<(echo 'dmmeta.pbsyntax  pbsyntax:proto2  comment:\"\"' && echo 'dmmeta.pbsyntax  pbsyntax:proto3  comment:\"\"' && echo 'dmmeta.ctype  ctype:pbt.Msg  comment:\"\"') -insert -check"
acr <- dmmeta.cpbuf  ctype:pbt.Msg  syntax:Proto3
# eof acr
acr -> stdin:1: Invalid value syntax:Proto3
acr -> dmmeta.cpbuf  ctype:pbt.Msg  syntax:Proto3
acr -> Type               dmmeta.Pbsyntax
acr -> Valid values       proto2, proto3
acr -> acr.badrefs  ctype:dmmeta.Cpbuf  nbad:1
acr -> report.acr_check  records:1  n_err:3
acr -> acr.insert  dmmeta.cpbuf  ctype:pbt.Msg  syntax:Proto3  comment:""
acr -> report.acr  n_select:1  n_insert:1  n_delete:0  n_ignore:0  n_update:0  n_file_mod:0  n_badline:0
# exit acr code:1
