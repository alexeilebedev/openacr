# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- amcdb.bltin  ctype:i8  likeu64:Y  bigendok:N  issigned:Y  comment:"8-bit   signed integer"
amc <- amcdb.bltin  ctype:u8  likeu64:Y  bigendok:N  issigned:N  comment:"8-bit unsigned integer"
amc <- amcdb.bltin  ctype:i16  likeu64:Y  bigendok:Y  issigned:Y  comment:"16-bit   signed integer"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- amcdb.bltin  ctype:u16  likeu64:Y  bigendok:Y  issigned:N  comment:"16-bit unsigned integer"
amc <- amcdb.bltin  ctype:i32  likeu64:Y  bigendok:Y  issigned:Y  comment:"32-bit   signed integer"
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- amcdb.bltin  ctype:u32  likeu64:Y  bigendok:Y  issigned:N  comment:"32-bit unsigned integer"
amc <- amcdb.bltin  ctype:i64  likeu64:Y  bigendok:Y  issigned:Y  comment:"64-bit   signed integer"
amc <- amcdb.bltin  ctype:u64  likeu64:Y  bigendok:Y  issigned:N  comment:"64-bit unsigned integer"
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- amcdb.bltin  ctype:u128  likeu64:N  bigendok:Y  issigned:N  comment:"128-bit unsigned integer"
amc <- amcdb.bltin  ctype:bool  likeu64:Y  bigendok:N  issigned:N  comment:"dflt is a c++ expr: real dflt is 'N'"
amc <- dmmeta.ctype  ctype:pad_byte  comment:""
amc <- dmmeta.csize  ctype:pad_byte  size:1  alignment:1  comment:""
amc <- dmmeta.cfmt  cfmt:pad_byte.String  printfmt:Extern  read:Y  print:Y  sep:""  genop:Y  comment:""
amc <- dmmeta.pack  ctype:pad_byte  comment:""
amc <- amcdb.bltin  ctype:char  likeu64:Y  bigendok:N  issigned:N  comment:char
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Free  comment:"reaches no ssimfile and declares no base"
amc <- dmmeta.field  field:algo_lib.Free.name  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.Derived  comment:"reaches no ssimfile through a base that has none either"
amc <- dmmeta.field  field:algo_lib.Derived.base  arg:algo_lib.Free  reftype:Base  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.Derived.dname  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.FreeId  comment:""
amc <- dmmeta.field  field:algo_lib.FreeId.value  arg:u8  reftype:Val  dflt:""  comment:""
amc <- dmmeta.gconst  field:algo_lib.FreeId.value  namefld:algo_lib.Free.name  idfld:""  wantenum:Y
amc <- dmmeta.ctype  ctype:algo_lib.DerivedId  comment:""
amc <- dmmeta.field  field:algo_lib.DerivedId.value  arg:u8  reftype:Val  dflt:""  comment:""
amc <- dmmeta.gconst  field:algo_lib.DerivedId.value  namefld:algo_lib.Derived.dname  idfld:""  wantenum:Y
amc <- dmmeta.field  field:algo_lib.FDb.free  arg:algo_lib.Free  reftype:Inlary  dflt:""  comment:""
amc <- dmmeta.inlary  field:algo_lib.FDb.free  min:0  max:4  comment:""
amc <- dmmeta.gstatic  field:algo_lib.FDb.free  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.derived  arg:algo_lib.Derived  reftype:Inlary  dflt:""  comment:""
amc <- dmmeta.inlary  field:algo_lib.FDb.derived  min:0  max:4  comment:""
amc <- dmmeta.gstatic  field:algo_lib.FDb.derived  comment:""
# eof amc
amc -> amc.gconst_nossimfile  gconst:algo_lib.FreeId.value  namefld:algo_lib.Free.name  comment:"the namefld's ctype reaches no ssimfile, so there is no value table"
amc -> amc.gconst_nossimfile  gconst:algo_lib.DerivedId.value  namefld:algo_lib.Derived.dname  comment:"the namefld's ctype reaches no ssimfile, so there is no value table"
amc -> amc.gstatic_nossimfile  field:algo_lib.FDb.free  basetype:algo_lib.Free  comment:"the element type reaches no ssimfile, so there is no table to load"
amc -> amc.gstatic_nossimfile  field:algo_lib.FDb.derived  basetype:algo_lib.Free  comment:"the element type reaches no ssimfile, so there is no table to load"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:4
