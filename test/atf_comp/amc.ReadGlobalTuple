amc -> // The format of the string is an ssim Tuple
amc -> bool algo_lib::FDb_ReadStrptrMaybe(algo_lib::FDb &parent, algo::strptr in_str) {
amc ->     bool retval = true;
amc ->     retval = algo::StripTypeTag(in_str, "algo_lib.FDb");
amc ->     ind_beg(algo::Attr_curs, attr, in_str) {
amc ->         retval = retval && FDb_ReadFieldMaybe(parent, attr.name, attr.value);
amc ->     }ind_end;
amc ->     return retval;
amc -> }
