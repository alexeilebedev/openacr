amc -> // --- algo_lib.FDb..ReadFieldMaybe
amc -> bool algo_lib::FDb_ReadFieldMaybe(algo_lib::FDb& parent, algo::strptr field, algo::strptr strval) {
amc ->     bool retval = true;
amc ->     algo_lib::FieldId field_id;
amc ->     (void)value_SetStrptrMaybe(field_id,field);
amc ->     switch(field_id) {
amc ->         case algo_lib_FieldId__db: {
amc ->             retval = false;
amc ->         } break;
amc ->         case algo_lib_FieldId_malloc: {
amc ->             retval = malloc_ReadStrptrMaybe(strval);
amc ->             if (retval) {
amc ->                 pmask_qSetBit(0); // mark presence in pmask
amc ->             }
amc ->         } break;
amc ->         case algo_lib_FieldId_pmask: {
amc ->             retval = false;
amc ->         } break;
amc ->         case algo_lib_FieldId_maxjobs: {
amc ->             retval = maxjobs_ReadStrptrMaybe(strval);
amc ->             if (retval) {
amc ->                 pmask_qSetBit(1); // mark presence in pmask
amc ->             }
amc ->         } break;
amc ->         case algo_lib_FieldId_timeout: {
amc ->             retval = timeout_ReadStrptrMaybe(strval);
amc ->             if (retval) {
amc ->                 pmask_qSetBit(2); // mark presence in pmask
amc ->             }
amc ->         } break;
amc ->         case algo_lib_FieldId_trace: {
amc ->             retval = trace_ReadStrptrMaybe(strval);
amc ->             if (retval) {
amc ->                 pmask_qSetBit(3); // mark presence in pmask
amc ->             }
amc ->         } break;
amc ->         default: {
amc ->             retval = false;
amc ->             algo_lib::AppendErrtext("comment", "unrecognized attr");
amc ->         } break;
amc ->     }
amc ->     if (!retval) {
amc ->         algo_lib::AppendErrtext("attr",field);
amc ->     }
amc ->     (void)parent;//only to avoid -Wunused-parameter
amc ->     return retval;
amc -> }
