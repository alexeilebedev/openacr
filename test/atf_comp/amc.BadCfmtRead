# eof amc
amc -> amc.badcfmt  cfmt:algo_lib.RCompact.String  strfmt:String  printfmt:CompactSep  comment:"no read path for this strfmt and printfmt"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:1
