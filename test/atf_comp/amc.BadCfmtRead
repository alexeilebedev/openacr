amc <- dmmeta.cfmt  cfmt:algo_lib.RAuto.String  printfmt:Auto  read:Y  print:N  sep:""  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RRaw  comment:""
amc <- dmmeta.field  field:algo_lib.RRaw.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.RRaw.String  printfmt:Raw  read:Y  print:N  sep:""  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RSep  comment:""
amc <- dmmeta.field  field:algo_lib.RSep.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.RSep.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.RSep.String  printfmt:Sep  read:Y  print:N  sep::  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RBitset  comment:""
amc <- dmmeta.field  field:algo_lib.RBitset.a  arg:bool  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.RBitset.b  arg:bool  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.RBitset.String  printfmt:Bitset  read:Y  print:N  sep:,  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RExtern  comment:""
amc <- dmmeta.field  field:algo_lib.RExtern.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.RExtern.String  printfmt:Extern  read:Y  print:N  sep:""  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RTupfmt  comment:""
