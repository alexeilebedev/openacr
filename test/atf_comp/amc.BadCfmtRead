# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u64  reftype:Val  dflt:""  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RCompact  comment:""
amc <- dmmeta.field  field:algo_lib.RCompact.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:algo_lib.RCompact.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.RCompact.String  printfmt:CompactSep  read:Y  print:N  sep:,  genop:N  comment:""
amc <- dmmeta.ctype  ctype:algo_lib.RQuiet  comment:""
amc <- dmmeta.field  field:algo_lib.RQuiet.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cfmt  cfmt:algo_lib.RQuiet.String  printfmt:CompactSep  read:N  print:N  sep:,  genop:N  comment:""
