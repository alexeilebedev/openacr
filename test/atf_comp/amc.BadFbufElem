amc -> amc.fbuf_elem  fbuf:algo_lib.FDb.in_wide  fbuftype:Bytebuf  arg:u16  nbyte:2  comment:"Bytebuf/Linebuf count length in bytes; the element type must be one byte wide"
amc -> amc.fbuf_elem  fbuf:algo_lib.FDb.in_word  fbuftype:Bytebuf  arg:u64  nbyte:8  comment:"Bytebuf/Linebuf count length in bytes; the element type must be one byte wide"
