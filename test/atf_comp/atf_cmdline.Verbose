# start atf_cmdline cmd:"$bindir/atf_cmdline -verbose -verbose blah -str blah"
# eof atf_cmdline
atf_cmdline -> astr:blah
atf_cmdline -> anum:0
atf_cmdline -> adbl:0
atf_cmdline -> aflag:N
atf_cmdline -> str:blah
atf_cmdline -> num:0
atf_cmdline -> dbl:0
atf_cmdline -> flag:N
atf_cmdline -> dstr:blah
atf_cmdline -> dnum:-33
atf_cmdline -> ddbl:0.0001
atf_cmdline -> dflag:Y
atf_cmdline -> fconst:high
atf_cmdline -> cconst:None
atf_cmdline -> dregx.expr:%
atf_cmdline -> dpkey:
atf_cmdline -> verbose:2
atf_cmdline -> debug:0
# exit atf_cmdline code:0
