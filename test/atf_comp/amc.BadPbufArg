# start amc cmd:"$bindir/amc -in_dir:- -out_dir: -report:N zzz < <(cat test/amc/bootstrap.ssim -)"
amc <- dmmeta.csize  ctype:u16  size:2  alignment:2  comment:""
amc <- dmmeta.csize  ctype:u32  size:4  alignment:4  comment:""
amc <- dmmeta.pack  ctype:u32  comment:""
amc <- dmmeta.csize  ctype:u128  size:16  alignment:16  comment:""
amc <- dmmeta.field  field:algo_lib.FDb.malloc  arg:u8  reftype:Malloc  dflt:""  comment:""
amc <- dmmeta.ns  ns:pbt  nstype:protocol  license:GPL  comment:""
amc <- dmmeta.nscpp  ns:pbt  comment:""
amc <- dmmeta.ctype  ctype:pbt.Color  comment:""
amc <- dmmeta.field  field:pbt.Color.value  arg:u8  reftype:Val  dflt:""  comment:""
amc <- dmmeta.fconst  fconst:pbt.Color.value/red  value:0  comment:""
amc <- dmmeta.fconst  fconst:pbt.Color.value/green  value:1  comment:""
amc <- dmmeta.ctype  ctype:pbt.Msg  comment:""
amc <- dmmeta.field  field:pbt.Msg.a  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.b  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.c  arg:u32  reftype:Inlary  dflt:""  comment:""
amc <- dmmeta.inlary  field:pbt.Msg.c  min:4  max:4  comment:""
amc <- dmmeta.field  field:pbt.Msg.d  arg:u32  reftype:Val  dflt:""  comment:""
amc <- dmmeta.field  field:pbt.Msg.e  arg:pbt.Color  reftype:Val  dflt:""  comment:""
amc <- dmmeta.cpbuf  ctype:pbt.Msg  syntax:proto3  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.a  field_number:1  pb_type:string  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.b  field_number:2  pb_type:message  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.c  field_number:3  pb_type:int32  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.d  field_number:4  pb_type:enum  packed:N  comment:""
amc <- dmmeta.fpbuf  field:pbt.Msg.e  field_number:5  pb_type:enum  packed:N  comment:""
# eof amc
amc -> amc.pbuf_arg  field:pbt.Msg.a  arg:u32  pb_type:string  argtype:algo.cstring  comment:"field arg incompatible with pb_type; the lib_pb codec accepts only argtype"
amc -> amc.pbuf_arg  field:pbt.Msg.b  arg:u32  pb_type:message  comment:"pb_type message requires a cpbuf arg with its own codec"
amc -> amc.pbuf_reftype  field:pbt.Msg.c  reftype:Inlary  comment:"fpbuf requires a Val, Tary or Bitfld field; this reftype has no wire mapping"
amc -> amc.pbuf_arg  field:pbt.Msg.d  arg:u32  pb_type:enum  comment:"pb_type enum requires an arg with an fconst-carrying i32 value field"
amc -> amc.pbuf_arg  field:pbt.Msg.e  arg:pbt.Color  pb_type:enum  comment:"pb_type enum requires an arg with an fconst-carrying i32 value field"
amc -> amc.no_output  comment:"no files were modified"
# exit amc code:5
