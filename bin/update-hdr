# The script takes no arguments and always writes; a flag that looked like a
# dry run was dropped on the floor here once, and a gate that cannot fail
# read as a pass.  Whether the tree changed is git's to say afterwards.

if [ $# -gt 0 ]; then
    echo "update-hdr: takes no arguments; it writes, and git status says what moved" >&2
    exit 1
fi
src_hdr -write -targsrc:% -scriptfile:%
